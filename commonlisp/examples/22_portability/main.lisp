;;;; ============================================================
;;;; examples/22_portability/main.lisp — 实现对比与可移植性
;;;; channel: both
;;;; ============================================================
;;;;
;;;; 本例程是「跨实现一致性」的现场教学：
;;;; 同一份代码在 SBCL 与 CLISP 上跑出的 stdout **逐字节相同**
;;;;（验证脚本第 5 条判定），因为下面每一节都在演示
;;;;   「实现有差异的地方 → 用什么写法抹平」。
;;;;
;;;; 演示：
;;;;   1. *features* 与 #+/#- 读取器条件：按实现选择代码路径
;;;;   2. fixnum 位宽：不打印值，代码不依赖位宽
;;;;   3. 浮点：显式后缀 + float 归一（pi / 传染规则的两个大坑）
;;;;   4. 哈希表顺序：先排序再输出
;;;;   5. 宏展开形态：只展开自己的宏
;;;;   6. 打印：*print-pretty* 关掉、广义布尔归一成 T/NIL
;;;;   7. 命令行参数：每家一个接口，#+/#- 统一封装
;;; ============================================================

;;; ----------------------------------------------------------
;;; 1. *features* 与 #+/#-
;;; ----------------------------------------------------------

;; *features* 是实现「自报家门」的列表；#+/#- 在**读取期**按它取舍代码。
;; 注意每行只打印统一文案——「识别」这件事本身是确定性的
(defun which-implementation ()
  #+sbcl :sbcl
  #+clisp :clisp
  #-(or sbcl clisp) :其他)

;; 三条代码路径，打印**完全相同**的一行——可移植代码的定义就是
;; 「分支不同，可观察行为相同」。实现名本身绝不能进输出
#+sbcl           (format t "实现识别: 已选中匹配分支（本行各实现同文）~%")
#+clisp          (format t "实现识别: 已选中匹配分支（本行各实现同文）~%")
#-(or sbcl clisp) (format t "实现识别: 已选中匹配分支（本行各实现同文）~%")

;; 运行期版本的条件判断：结果归一成 T，不打印符号本身
(format t "运行期识别: 在已知实现之列 → ~A~%"
        (if (member (which-implementation) '(:sbcl :clisp)) t nil))

;; 经典应用：条件编译平台相关常量
(defparameter *line-ending*
  #+win32 "CRLF"
  #-win32 "LF")
(format t "平台行尾（读取期决定）: ~A~%" *line-ending*)


;;; ----------------------------------------------------------
;;; 2. fixnum 位宽：用事实，不用数值
;;; ----------------------------------------------------------

;; SBCL 的 fixnum 是 62 位、CLISP（本机构建）是 48 位——
;; 可移植代码对位宽只有两条合法假设：
(format t "fixnum 至少 16 位: ~A~%" (>= (integer-length most-positive-fixnum) 16))
(format t "大数自动升级: ~A~%"
        (typep (* most-positive-fixnum 2) 'bignum))


;;; ----------------------------------------------------------
;;; 3. 浮点：显式后缀 + float 归一
;;; ----------------------------------------------------------

;; 坑 1：pi 在 CLISP 是长浮点（打印 L0），SBCL 是双精度（d0）
(format t "π 的双精度值（归一后两实现一致）: ~A~%" (float pi 1.0d0))

;; 坑 2：单双混算的传染规则——CLISP 默认非 ANSI（取单精度）
(format t "混算显式归一: ~A~%" (float (+ 1.5f0 2.25d0) 1.0d0))

;; 坑 3：精确数学的「溢出点」不同——CLISP 的 (sqrt -4) 给精确复数，
;; SBCL 给浮点复数；想要一致就先归一输入
(format t "复数归一: ~A~%" (abs #C(3.0d0 4.0d0)))


;;; ----------------------------------------------------------
;;; 4. 哈希表顺序
;;; ----------------------------------------------------------

(let ((table (make-hash-table :test 'equal)))
  (setf (gethash "banana" table) 2
        (gethash "apple" table) 1
        (gethash "cherry" table) 3)
  ;; 遍历顺序两实现不同（且同实现不同运行也可能不同）——排序后输出
  (let ((sorted (sort (loop for k being each hash-key of table
                            collect (cons k (gethash k table)))
                      #'string< :key #'car)))
    (format t "哈希排序输出: ~S~%" sorted)))


;;; ----------------------------------------------------------
;;; 5. 宏展开形态
;;; ----------------------------------------------------------

;; 内置宏（when/and/cond…）展开成什么样是实现自由：
;;   (macroexpand-1 '(when a b))
;;     SBCL → (IF A (PROGN B))   CLISP → (IF A (PROGN B)) 形似但细节有别
;; 自己的宏展开完全可控——需要「看展开做逻辑」时用自己的宏
(defmacro my-and (a b)
  `(if ,a ,b nil))

(let ((*print-pretty* nil))
  (format t "自有宏展开（两实现一致）: ~S~%"
          (macroexpand-1 '(my-and x y))))


;;; ----------------------------------------------------------
;;; 6. 打印差异三连
;;; ----------------------------------------------------------

;; ① pretty：SBCL 默认开（长表换行 + 'x 缩写），CLISP 默认关——
;;    打印代码结构前显式绑定
(let ((*print-pretty* nil))
  (format t "打印归一①: ~S~%" '(some (long enough list to wrap without binding))))

;; ② 广义布尔：CLISP 的 fboundp 等规矩地返回 T，
;;    SBCL 可能返回「任意非 NIL 真值」——输出前归一
(format t "打印归一②: ~A~%" (if (fboundp 'car) t nil))

;; ③ 条件对象/内置报错的文本是实现自由——只打印自己写的文案
;;（18 章的约定，这里再演示一次）
(format t "打印归一③: ~A~%"
        (handler-case (parse-integer "x")
          (error () :我们的统一文案)))


;;; ----------------------------------------------------------
;;; 7. 命令行参数与退出：每家一个接口
;;; ----------------------------------------------------------

(defun program-arguments ()
  #+sbcl (cdr (member "--" sb-ext:*posix-argv* :test #'string=))
  #+clisp ext:*args*
  #-(or sbcl clisp) nil)

(defun portable-quit (&optional (code 0))
  #+sbcl (sb-ext:quit :unix-status code)
  #+clisp (ext:quit code)
  #-(or sbcl clisp) nil)

(format t "参数访问器（无参运行 → 空）: ~S~%" (program-arguments))
(format t "退出封装已定义（此处不调用）: ~A~%" (functionp #'portable-quit))


;;; ----------------------------------------------------------
;;; 8. 可移植代码五条军规（总结）
;;; ----------------------------------------------------------

(format t "
军规：
  1. 平台/实现相关 → #+/#- 读取期分发，绝不运行期赌
  2. 数值 → 显式后缀/float 归一；fixnum 位宽当不存在
  3. 哈希表 → 输出前排序；遍历只遍历排序后的键
  4. 打印 → pretty 关掉；广义布尔归一；报错文案自己写
  5. 深递归 → 改 loop；别赌尾调用优化（CLISP 几千层就爆栈）
~%")

(format t "==== 22 结束 ====~%")
