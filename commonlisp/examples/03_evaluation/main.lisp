;;;; ============================================================
;;;; examples/03_evaluation/main.lisp — 求值模型
;;;; channel: both
;;;; ============================================================
;;;;
;;;; 本例程演示：
;;;;   1. 读入（read）与求值（eval）是两个阶段
;;;;   2. quote：拿「代码本身」当数据
;;;;   3. 大小写：读入器把符号名统一转成大写
;;;;   4. 自求值对象
;;;;   5. 特殊形式 / 宏 / 函数：三种时机
;;;;
;;;; 注意：打印「代码」时统一绑 *print-pretty* 为 nil——
;;;; SBCL 默认 pretty 打印会把长表拆成多行，CLISP 默认单行，
;;;; 想要跨实现逐字节一致的输出必须把它关掉（这本身就是可移植性
;;;; 的经典差异，22 章细讲）。
;;;; ============================================================

;;; ----------------------------------------------------------
;;; 1. 读入与求值是两件事
;;; ----------------------------------------------------------

;; read-from-string 只「读」不求值：得到的是数据（一张表）
(let ((*print-pretty* nil))
  (format t "读入: ~S~%" (read-from-string "(+ 1 2)")))

;; eval 对那张表求值：得到 3
(format t "求值: ~S~%" (eval (read-from-string "(+ 1 2)")))

;; 读进来的表与手写 quote 的表是同一种东西——代码即数据
(let ((form (read-from-string "(* 6 7)")))
  (format t "form 是列表: ~A，第一项是: ~S~%" (listp form) (first form))
  (format t "再求值: ~S~%" (eval form)))


;;; ----------------------------------------------------------
;;; 2. quote：拿「代码本身」当数据
;;; ----------------------------------------------------------

;; 'x 只是 (quote x) 的缩写——单引号是一个读取宏。
;; 注意 ''x 的打印：SBCL 只在 *print-pretty* 打开时才用 ' 缩写（CLISP
;; 恒用缩写），想跨实现一致打印这里必须把 pretty 打开——与上面相反！
(let ((*print-pretty* nil))
  (format t "'x 读入后是: ~S~%" 'x)
  (format t "(quote x) 求值后是符号: ~A~%" (quote x)))
(let ((*print-pretty* t))
  (format t "两层引号: ~S~%" ''x))


;;; ----------------------------------------------------------
;;; 3. 大小写：读入器把符号名转成大写
;;; ----------------------------------------------------------

(format t "符号名: ~S~%" (symbol-name 'hello-world))     ; "HELLO-WORLD"
(format t "大小写不同=同一个符号: ~A~%" (eq 'Hello 'hello))

;; |...| 竖线转义可以保留大小写（很少用，但要知道）
(format t "转义符号名: ~S~%" (symbol-name '|helloWorld|))

;; 字符串大小写不受影响——它就是数据
(format t "字符串保留大小写: ~S~%" "Hello World")


;;; ----------------------------------------------------------
;;; 4. 自求值对象：这些不求值，自己就是自己的值
;;; ----------------------------------------------------------

(format t "数字 ~S  字符串 ~S  关键字 ~S~%" 42 "str" :key)
(format t "字符 ~S  T ~S  NIL ~S~%" #\a t nil)
(format t "空表 () 与 NIL 是同一个东西: ~A~%" (eq '() nil))


;;; ----------------------------------------------------------
;;; 5. 特殊形式 / 宏 / 函数：三种东西，三种时机
;;; ----------------------------------------------------------

;; 函数：实参**全部先求值**，再进函数体
(format t "实参先算完: ~S~%" (+ (* 2 3) (* 4 5)))

;; 特殊形式：if 的 else 分支不求值（短路）
(format t "if 只算选中的分支: ~S~%"
        (if nil (error "不会执行") :走了-then-之外的分支))

;; quote 也是特殊形式：它后面那项**就是**数据
(format t "quote 后面的内容不求值: ~S~%" '(+ 1 2))

;; 宏：展开在先，求值在后。展开自己的宏（展开结果跨实现一致；
;; 展开内置宏则各实现形态不同，别依赖它——见 22 章）
(defmacro one-plus (x)
  `(+ ,x 1))

(let ((*print-pretty* nil))
  (format t "宏展开一层: ~S~%" (macroexpand-1 '(one-plus 41)))
  (format t "宏求值:     ~S~%" (one-plus 41)))

;; #' 是 (function ...) 的读取宏：取函数对象本身，不求值调用
(format t "#'car 是函数对象: ~A~%" (functionp #'car))
(format t "(function car) 等价于 #'car: ~A~%"
        (functionp (function car)))


;;; ----------------------------------------------------------
;;; 6. eval 的代价（说明）
;;; ----------------------------------------------------------
;;;;
;;;; eval 在运行期构造/求值代码，无法被编译器优化，且作用域是全局
;;;; 词法环境——拿不到局部变量。本教程只在「教学演示」与「读取-求值
;;;; 循环（REPL）」里用它；写程序时几乎总有更好的办法（函数、闭包、
;;;; 宏）。27 章的迷你解释器会以「不用 eval」的方式实现 eval 的语义。


(format t "~%==== 03 结束 ====~%")
