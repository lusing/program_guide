;;;; ============================================================
;;;; examples/16_format/main.lisp — format 格式化输出
;;;; channel: both
;;;; ============================================================
;;;;
;;;; 本例程演示：
;;;;   1. ~A 与 ~S：人读的 / 机器读的
;;;;   2. 整数家族：~D ~B ~O ~X ~R（罗马、英文、任意进制）
;;;;   3. 浮点家族：~F ~E ~G ~$
;;;;   4. 宽度、对齐与填充（~A 与 ~D 的补空格方向**相反**！）
;;;;   5. 换行与制表：~% ~& ~T（以及 ~| 是换页不是竖线的坑）
;;;;   6. 条件 ~[ ~] 与迭代 ~{ ~}
;;;;   7. 参数跳位 ~* 与整表回退
;;;;   8. 大小写调制 ~( ~)
;;; ============================================================

;;; ----------------------------------------------------------
;;; 1. ~A 与 ~S
;;; ----------------------------------------------------------

(format t "~A | ~S~%" "hello" "hello")   ; hello | "hello"
(format t "~A | ~S~%" 'sym 'sym)          ; SYM | SYM
(format t "~A | ~S~%" 42 42)

;;; ----------------------------------------------------------
;;; 2. 整数家族
;;; ----------------------------------------------------------

(format t "~D ~B ~O ~X~%" 255 255 255 255)
(format t "36 进制: ~36R~%" 1234567890)
(format t "英文基数: ~R~%" 42)
(format t "英文序数: ~:R~%" 42)
(format t "罗马数字: ~@R，旧式: ~:@R~%" 42 42)
(format t "千分位: ~:D~%" 1234567890)

;;; ----------------------------------------------------------
;;; 3. 浮点家族
;;; ----------------------------------------------------------

(format t "固定小数: ~F / 两位: ~,2F~%" 3.14159265d0 3.14159265d0)
(format t "宽度+小数: ~10,2F|~%" 3.14159265d0)
;; 坑：~E 打单精度数时，指数标记的大小写与有效位数两实现不同
;; （SBCL「3.1415926e+4」/ CLISP「3.1415924E+4」）——想要一致用双精度
(format t "科学计数: ~E / 两位: ~,2E~%" 31415.9265d0 31415.9265d0)
(format t "货币: ~$ / 三位: ~,3$~%" 1234.567d0 1234.567d0)

;;; ----------------------------------------------------------
;;; 4. 宽度、对齐与填充
;;; ----------------------------------------------------------

;; 坑位复述：mincol 必须非负——~-10D 直接报错。
;; 想要「左对齐的数字」用 ~A：两种指令的补空格方向正好相反
(format t "右对齐数字: [~10D]|~%" 42)
(format t "左对齐数字: [~10A]|~%" 42)
(format t "补零: [~10,'0D]|~%" 42)
(format t "@版带符号: [~10@D]|~%" 42)
(format t "字符串定宽: [~10A][~10A]|~%" "lisp" "cl")

;;; ----------------------------------------------------------
;;; 5. 换行与制表
;;; ----------------------------------------------------------

(format t "两行~%看效果~%")
(format t "a~&b~&b~%")            ; ~&：不在行首才换行
;; ~T 跳列。注意：列宽按「字符」还是按「显示宽度」数，CJK 时两实现
;; 不一致——对齐表格请用 ASCII 内容或干脆用 ~A 定宽（上面第 4 节）
(format t "col: ~10Tname~20Tscore~%")
(format t "     ~10Tzhang~20T95~%")
(format t "波浪号本身: ~~~%")

;; 坑：~| 输出的是**换页符**（#\Page，控制字符），不是表格竖线！
;; 它混进 stdout 会撞上「无多余控制字符」的判定（本仓库四条判定第 3 条）
;;—— 表格竖线请老老实实写字符 "|"。

;;; ----------------------------------------------------------
;;; 6. 条件与迭代
;;; ----------------------------------------------------------

;; ~[参数索引选择~;分支~;~] —— 索引从 0 开始，: 是默认分支
(format t "索引 0 → ~[红~;绿~;蓝~:;其他~]~%" 0)
(format t "索引 2 → ~[红~;绿~;蓝~:;其他~]~%" 2)
(format t "索引 9 → ~[红~;绿~;蓝~:;其他~]~%" 9)

;; ~[ 前面不给参数、用 : 修饰 → 按「是不是 NIL」二选一（布尔分支）
(format t "布尔: ~:[假~;真~] / ~:[假~;真~]~%" nil 7)

;; ~{...~}：吃一个**列表**参数，逐项迭代；~^ 在最后一项前提前收尾
(format t "迭代: ~{<~A>~^ ~}~%" '(1 2 3))
;; @ 版直接把剩余所有参数当列表
(format t "@迭代: ~@{[~A]~^,~}~%" :a :b :c)
;; 嵌套：外层遍历行，内层遍历列
(format t "表格: ~{~{~2D~^ ~}~^ | ~}~%" '((1 2) (3 4) (5 6)))

;;; ----------------------------------------------------------
;;; 7. 参数跳位 ~*
;;; ----------------------------------------------------------

;; ~* 跳过下一个实参；~:* 回退一个；~3* 跳三个
(format t "跳过: ~A ~* ~A~%" "第一" "被跳过" "第三")
(format t "回退重用: ~A ~:* 再来一次 ~A~%" "同一份")

;;; ----------------------------------------------------------
;;; 8. 大小写调制
;;; ----------------------------------------------------------

(format t "全小写: ~(~S~)~%" "MIXED Case 字符串")
(format t "全大写: ~@(~S~)~%" "mixed case")
(format t "首字母大写: ~:(~A~)~%" "hello format world")

;;; ----------------------------------------------------------
;;; 9. format nil：拼字符串而不是输出
;;; ----------------------------------------------------------

;; 坑位收藏：CLISP 的 ~A 遇到**含换行的字符串**会自动在它前后断行
;; （走 pretty 填充），SBCL 则原样内联——跨实现一致的输出里，别把
;; 带换行的字符串交给 ~A，换行自己用 ~% 显式打
(let ((report (format nil "报告：~A 项，命中率 ~,1F%" 3 66.66667)))
  (format t "拼好的串长度 ~A：~A~%" (length report) report))


(format t "==== 16 结束 ====~%")
