;;;; ============================================================
;;;; examples/04_numbers/main.lisp — 数字：数值塔
;;;; channel: both
;;;; ============================================================
;;;;
;;;; 本例程演示：
;;;;   1. 整数：任意精度，不会溢出
;;;;   2. 有理数：算得准，不落成小数
;;;;   3. 浮点：f0/d0 后缀与跨实现的坑（默认精度不同！）
;;;;   4. 复数
;;;;   5. 取整家族：floor/ceiling/truncate/round（四舍六入五成双）
;;;;   6. 除法与取余：mod 与 rem 的符号规则
;;;;   7. 位运算与移位
;;;;
;;;; 可移植性铁律（详见 22 章）：
;;;;   - 不要打印 pi / 默认精度的 (/ 1.0 3)：SBCL 给双精度 d0，
;;;;     CLISP 给长浮点 L0，输出不一致
;;;;   - 要确定精度就显式写后缀或用 (float x 1.0d0) 归一
;;;;   - 不要打印 most-positive-fixnum 的值：位宽随实现（62 vs 48）
;;;; ============================================================

;;; ----------------------------------------------------------
;;; 1. 整数：任意精度
;;; ----------------------------------------------------------

(format t "2 的 100 次方: ~D~%" (expt 2 100))
(format t "阶乘 25!: ~D~%" (reduce #'* (loop for i from 1 to 25 collect i)))

;; fixnum 只是「机器字长装得下」的快速档；超了自动升 bignum
(format t "fixnum 装得下 1 百万: ~A，位宽随实现不打印~%"
        (typep 1000000 'fixnum))


;;; ----------------------------------------------------------
;;; 2. 有理数：精确算术
;;; ----------------------------------------------------------

(format t "1/3 + 1/6 = ~A~%" (+ 1/3 1/6))          ; 1/2（不是 0.5）
(format t "1/3 + 1/3 + 1/3 = ~A~%" (+ 1/3 1/3 1/3)) ; 1（精确等于 1）
(format t "有理数自动约分: ~A~%" (/ 10 4))           ; 5/2
(format t "整数结果就不带分母: ~A~%" (/ 10 5))       ; 2

;; 与浮点混算才落成浮点（精度统一取「塔上」的那个）
(format t "1/3 显式转单精度: ~A~%" (float 1/3 1.0f0))
(format t "1/3 显式转双精度: ~A~%" (float 1/3 1.0d0))
(format t "π 归一到双精度: ~A~%" (float pi 1.0d0))


;;; ----------------------------------------------------------
;;; 3. 浮点：后缀决定精度
;;; ----------------------------------------------------------

;; 后缀：f0=单精度 s0=短精度 d0=双精度 l0=长精度
(format t "单精度字面量: ~A~%" 3.14f0)
(format t "双精度字面量: ~A~%" 3.14159265358979d0)

;; 跨实现安全的写法：永远带后缀，或用 float 归一
(format t "0.1+0.2（双精度）: ~A~%" (+ 0.1d0 0.2d0))

;; 单双精度混算——大坑：ANSI 规定结果取「更高」的类型（double），
;; SBCL 遵守；CLISP 默认的浮点传染规则是非 ANSI 的（结果取单精度，
;; 除非设置 ext:*floating-point-contagion-ansi*）。想要一致就显式归一：
(format t "f0 与 d0 混算显式归一到 d0: ~A~%"
        (float (+ 1.5f0 2.25d0) 1.0d0))


;;; ----------------------------------------------------------
;;; 4. 复数
;;; ----------------------------------------------------------

(format t "复数字面量: ~A~%" #C(3 4))
(format t "实部 ~A 虚部 ~A~%" (realpart #C(3 4)) (imagpart #C(3 4)))
(format t "模（勾股定理，浮点输入）: ~A~%" (abs #C(3.0 4.0)))

;; 复数运算
(format t "i 的平方: ~A~%" (* #C(0 1) #C(0 1)))
(format t "复数共轭: ~A~%" (conjugate #C(1 -2)))

;; 注意：CLISP 里 (sqrt -4) 得到**精确**复数 #C(0 2)，
;; SBCL 得到浮点复数 #C(0.0 2.0)。同理 (log 8 2) 在 CLISP 里是精确的 3、
;; 在 SBCL 里是 3.0。想要一致就显式给浮点输入：
(format t "sqrt 4.0: ~A, log 8.0d0 2.0d0: ~A~%" (sqrt 4.0) (log 8.0d0 2.0d0))


;;; ----------------------------------------------------------
;;; 5. 取整家族：四个函数两套语义
;;; ----------------------------------------------------------

;; floor 向下 / ceiling 向上 / truncate 向零 / round 就近（.5 取偶）
(flet ((show (fn-name x)
         (multiple-value-bind (q r) (funcall (symbol-function fn-name) x)
           (format t "(~A ~A) → 商 ~A 余 ~A~%" fn-name x q r))))
  (show 'floor 7/2)
  (show 'ceiling 7/2)
  (show 'truncate 7/2)
  (show 'round 7/2)     ; 7/2=3.5 → 4（偶数方向）
  (show 'round 5/2)     ; 5/2=2.5 → 2（同样取偶）
  (show 'truncate -7/2)
  (show 'floor -7/2))

;; 带除数的版本：返回 商 和 余数（与除数同号——floor 语义）
(multiple-value-bind (q r) (floor 17 5)
  (format t "floor 17 5 → ~A 余 ~A~%" q r))


;;; ----------------------------------------------------------
;;; 6. mod 与 rem：符号跟随谁？
;;; ----------------------------------------------------------

;; mod 的余数符号跟**除数**；rem 跟**被除数**（C 的 %）
(format t "mod 17 5 = ~A, rem 17 5 = ~A~%" (mod 17 5) (rem 17 5))
(format t "mod -17 5 = ~A, rem -17 5 = ~A~%" (mod -17 5) (rem -17 5))
(format t "mod 17 -5 = ~A, rem 17 -5 = ~A~%" (mod 17 -5) (rem 17 -5))


;;; ----------------------------------------------------------
;;; 7. 常用数学函数与比较
;;; ----------------------------------------------------------

(format t "gcd 12 18 = ~A, lcm 4 6 = ~A~%" (gcd 12 18) (lcm 4 6))
(format t "max/min: ~A ~A~%" (max 3 1 4 1 5) (min 3 1 4 1 5))
(format t "abs -7/2 = ~A~%" (abs -7/2))
;; exp/log 的「精确 vs 浮点」是实现差异：CLISP 里 (exp 0) 得精确的 1、
;; (log 8 2) 得精确的 3，SBCL 给 1.0 / 3.0。要一致就给浮点输入
(format t "exp 0.0 = ~A~%" (exp 0.0))
(format t "sqrt 2.0（单精度）: ~A~%" (sqrt 2.0f0))

;; = 比的是**数值**，跨类型也相等；eql 才要求类型一致
(format t "(= 2 2.0) = ~A, (eql 2 2.0) = ~A~%" (= 2 2.0) (eql 2 2.0))
(format t "(/= 1 2 3) = ~A, (/= 1 1 2) = ~A~%" (/= 1 2 3) (/= 1 1 2))
(format t "谓词: zerop ~A, plusp ~A, evenp ~A~%"
        (zerop 0) (plusp 5) (evenp 6))


;;; ----------------------------------------------------------
;;; 8. 位运算（整数当比特串）
;;; ----------------------------------------------------------

(format t "and: ~B~%" (logand #b1100 #b1010))    ; 1000
(format t "ior: ~B~%" (logior #b1100 #b1010))    ; 1110
(format t "xor: ~B~%" (logxor #b1100 #b1010))    ; 0110
(format t "not 0b0..011 = ~D~%" (lognot 3))      ; -4（补码）
(format t "ash 左移 1 位 = ~D, 右移 = ~D~%"
        (ash 5 1) (ash 5 -1))
(format t "logcount 15 = ~A~%" (logcount 15))    ; 4 个 1
(format t "logtest: ~A~%" (logtest #b1100 #b0010)) ; 有公共位 → T

(format t "~%==== 04 结束 ====~%")
