# 这些文件必须保持 LF：bash 脚本在 WSL/Linux 里跑（CRLF 会报 bash\r），
# gforth 的 .fs 源码同理（CRLF 会把 \r 混进 token）。
*.sh text eol=lf
forth/**/*.fs text eol=lf
# SML 源码在 WSL 里跑三套编译器：CRLF 会混进注释/字符串比较，统一 LF。
sml/examples/*.sml text eol=lf
# Go 源码 gofmt 只认 LF：autocrlf=true 检出成 CRLF 后 gofmt -l 会整文件标记
# （build.ps1 的四层验证第一层就挂）。统一 LF。
go/**/*.go text eol=lf
# Zig 源码 zig fmt 只认 LF：autocrlf=true 检出成 CRLF 后 fmt --check 整文件挂
# （build.ps1 三层验证第一层就挂；混合行尾时只有部分行报）。统一 LF。
zig/**/*.zig text eol=lf
# typetheory 的 .agda 源码在 WSL 里由 agda 直接检查：统一 LF。
typetheory/**/*.agda text eol=lf
# category 的 .agda 源码同理：统一 LF。
category/**/*.agda text eol=lf
# mathlogic 的 .agda（WSL agda）、.thy（Isabelle/Cygwin）、.sml（HOL4/WSL）统一 LF。
mathlogic/**/*.agda text eol=lf
mathlogic/**/*.thy text eol=lf
mathlogic/examples/**/*.sml text eol=lf
mathlogic/tools/*.sh text eol=lf
