<Window
    x:Class="OsIntApp.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <StackPanel Margin="24" Spacing="12">
        <TextBlock x:Name="StatusText" Text="Ready" FontSize="18" TextWrapping="Wrap" />
        <Button Content="Show app data path" Click="OnShowPathClicked" />
        <Button Content="Pick a .json file" Click="OnPickClicked" />
        <Button Content="Run child process" Click="OnRunToolClicked" />
    </StackPanel>
</Window>
