<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="MediaLibrary.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Margin="24" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 冒烟判读锚点：状态行永远在最上面 -->
        <TextBlock x:Name="StatusText"
                   Grid.Row="0"
                   Text="opening database..."
                   FontSize="14"
                   TextWrapping="Wrap"/>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="12">
            <TextBlock Text="Category:" VerticalAlignment="Center"/>
            <!-- 过滤项静态表：内联 <x:String>（SettingsHub 先例）。两条 x:Bind 路线
                 在此双双踩坑：TwoWay SelectedItem 回程要 to_hstring(IInspectable)（编译错）；
                 OneWay ItemsSource 直绑 IVector<String> 运行期 stowed E_INVALIDARG
                 （37.8 坑位实录）。静态条目根本不需要绑定。 -->
            <ComboBox x:Name="CategoryFilter"
                      MinWidth="140"
                      SelectionChanged="OnCategoryChanged">
                <x:String>All</x:String>
                <x:String>Book</x:String>
                <x:String>Music</x:String>
                <x:String>Video</x:String>
            </ComboBox>
            <Button Content="Add Item"
                    Style="{StaticResource AccentButtonStyle}"
                    Click="{x:Bind ViewModel.AddItem}"/>
            <!-- CanExecute 的活儿这里用 HasSelection 属性承担（36 章对比两条路线） -->
            <Button Content="Delete Selected"
                    IsEnabled="{x:Bind ViewModel.HasSelection, Mode=OneWay}"
                    Click="{x:Bind ViewModel.DeleteSelected}"/>
        </StackPanel>

        <ListView Grid.Row="2"
                  ItemsSource="{x:Bind ViewModel.Items}"
                  SelectionMode="Single"
                  SelectionChanged="OnSelectionChanged">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="local:MediaItem"
                              xmlns:local="using:MediaLibrary">
                    <Grid ColumnSpacing="16" Padding="4,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="110"/>
                            <ColumnDefinition Width="110"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold"/>
                        <TextBlock Grid.Column="1" Text="{x:Bind Category}" Opacity="0.75"/>
                        <TextBlock Grid.Column="2" Text="{x:Bind Location}" Opacity="0.55"/>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <TextBlock Grid.Row="3"
                   Text="{x:Bind ViewModel.DbPath, Mode=OneWay}"
                   FontSize="11"
                   Opacity="0.55"
                   TextTrimming="CharacterEllipsis"/>
    </Grid>
</Window>
