<Page
    x:Class="BasicGallery.DateTimePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Margin="24">
        <StackPanel Spacing="12" MaxWidth="480">
            <TextBlock x:Name="StatusText" Text="Ready" FontSize="18"/>

            <!-- 16.2 DatePicker：日/月/年三个 spinner；Date 是 IReference<DateTime> -->
            <DatePicker x:Name="Pick" Header="Due date" DateChanged="OnDateChanged"/>

            <!-- 16.3 TimePicker：Time 是 TimeSpan -->
            <TimePicker x:Name="TimePick" Header="Reminder time"/>

            <!-- 16.4 CalendarDatePicker：下拉日历 -->
            <CalendarDatePicker x:Name="CalendarPick" Header="Calendar pick"
                                PlaceholderText="pick a date..."/>

            <Button Content="Set to today" Click="OnTodayClicked"/>
        </StackPanel>
    </Grid>
</Page>
