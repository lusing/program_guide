<Page
    x:Class="BasicGallery.TextBlockPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Margin="24">
        <StackPanel Spacing="12">
            <TextBlock x:Name="StatusText" Text="Ready" FontSize="18"/>

            <!-- 8.2 富文本：一个 TextBlock，多段 Run -->
            <TextBlock FontSize="16" TextWrapping="Wrap">
                <Run FontWeight="Bold" Text="Bold lead. "/>
                <Run Foreground="Red" Text="Red middle. "/>
                <Run FontStyle="Italic" Text="Italic tail."/>
            </TextBlock>

            <!-- 8.3 截断演示：固定宽度，按钮循环切换 TextTrimming -->
            <TextBlock x:Name="TrimDemo" Width="360" TextAlignment="Left"
                       Text="The quick brown fox jumps over the lazy dog 0123456789"/>
            <Button Content="Cycle trim mode" Click="OnCycleTrimClicked"/>

            <!-- 8.3 换行对比：NoWrap 直接出界，Wrap 折行 -->
            <TextBlock Width="360" Text="NoWrap: The quick brown fox jumps over the lazy dog."/>
            <TextBlock Width="360" TextWrapping="Wrap"
                       Text="Wrap: The quick brown fox jumps over the lazy dog and keeps going."/>
            <TextBlock Width="360" TextWrapping="WrapWholeWords"
                       Text="WrapWholeWords: whole words are never split across lines."/>

            <!-- 8.5 可选中文本 -->
            <TextBlock IsTextSelectionEnabled="True"
                       Text="This line is selectable (IsTextSelectionEnabled)."/>
        </StackPanel>
    </Grid>
</Page>
