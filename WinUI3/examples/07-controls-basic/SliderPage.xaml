<Page
    x:Class="BasicGallery.SliderPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Margin="24">
        <StackPanel Spacing="12" MaxWidth="480">
            <TextBlock x:Name="StatusText" Text="Ready" FontSize="18"/>

            <!-- 12.2 Slider：RangeBase 全家（Minimum/Maximum/Value/StepFrequency） -->
<!-- 12.3 ProgressBar 确定进度：Value 被 Slider 直写驱动（声明在 Slider 之前：XAML 按文档序构建，解析期触发的 ValueChanged 不能引用后面才建立的控件） -->
            <ProgressBar x:Name="SyncBar" Minimum="0" Maximum="100" Value="25"/>

            <Slider x:Name="VolumeSlider" Header="Volume"
                    Minimum="0" Maximum="100" Value="25"
                    StepFrequency="1" TickFrequency="25" TickPlacement="BottomRight"
                    ValueChanged="OnVolumeChanged"/>

            <!-- 12.3 ProgressRing：按钮运行时切换 IsActive -->
            <StackPanel Orientation="Horizontal" Spacing="12">
                <ProgressRing x:Name="BusyRing" IsActive="False" Width="32" Height="32"/>
                <Button Content="Toggle busy ring" Click="OnToggleBusyClicked"/>
            </StackPanel>

            <!-- 12.4 RatingControl：MaxRating/PlaceholderValue/Caption -->
            <RatingControl x:Name="Importance" Caption="importance" MaxRating="5"
                           Value="3" ValueChanged="OnRatingChanged"/>
        </StackPanel>
    </Grid>
</Page>
