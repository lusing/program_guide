<Page
    x:Class="BasicGallery.ComboBoxPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Margin="24">
        <StackPanel Spacing="12" MaxWidth="480">
            <TextBlock x:Name="StatusText" Text="Ready" FontSize="18"/>

            <!-- 14.2 静态项：x:String 直接装箱；SelectedItem 是 IInspectable 要 unbox -->
            <ComboBox x:Name="ThemeBox" Header="Theme" PlaceholderText="pick one..."
                      SelectionChanged="OnThemeChanged">
                <x:String>Light</x:String>
                <x:String>Dark</x:String>
                <x:String>System</x:String>
            </ComboBox>

            <!-- 14.4 可编辑 ComboBox：可输入过滤（IsEditable 是 WinUI 3 新增能力） -->
            <ComboBox x:Name="CountryBox" Header="Country (editable)" IsEditable="True"
                      PlaceholderText="type to filter...">
                <x:String>China</x:String>
                <x:String>Japan</x:String>
                <x:String>United States</x:String>
            </ComboBox>

            <!-- 14.3 程序化选择：触发同一 SelectionChanged -->
            <Button Content="Select Dark" Click="OnSelectDarkClicked"/>
        </StackPanel>
    </Grid>
</Page>
