<Page
    x:Class="BasicGallery.AutoSuggestPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Margin="24">
        <StackPanel Spacing="12" MaxWidth="480">
            <TextBlock x:Name="StatusText" Text="Ready" FontSize="18"/>

            <!-- 15.2 搜索式输入：TextChanged 过滤 -> ItemsSource 更新 -> SuggestionChosen -->
            <AutoSuggestBox x:Name="FruitBox" Header="Fruit" PlaceholderText="type 'ap'..."
                            TextChanged="OnFruitTextChanged"
                            SuggestionChosen="OnFruitChosen"
                            QuerySubmitted="OnFruitQuerySubmitted"/>
        </StackPanel>
    </Grid>
</Page>
