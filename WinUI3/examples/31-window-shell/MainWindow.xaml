<Window
    x:Class="WindowShellApp.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="44"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 31.2 自绘标题栏：ExtendsContentIntoTitleBar + SetTitleBar -->
        <Border x:Name="AppTitleBar" Grid.Row="0" Padding="14,0,0,0">
            <TextBlock x:Name="AppTitle" Text="WindowShell" VerticalAlignment="Center"
                       FontWeight="SemiBold"/>
        </Border>

        <StackPanel Grid.Row="1" Margin="24" Spacing="14" MaxWidth="480">
            <TextBlock x:Name="StatusText" Text="Ready" FontSize="18"/>

            <!-- 31.3 SystemBackdrop：None / Mica / Acrylic -->
            <TextBlock Text="Backdrop:" FontWeight="SemiBold"/>
            <StackPanel Orientation="Horizontal" Spacing="12">
                <Button Content="None" Click="OnBackdropNone"/>
                <Button Content="Mica" Click="OnBackdropMica"/>
                <Button Content="Acrylic" Click="OnBackdropAcrylic"/>
            </StackPanel>

            <!-- 31.4 多窗口 -->
            <Button Content="New window" Click="OnNewWindowClicked"/>

            <TextBlock TextWrapping="Wrap" Opacity="0.7"
                       Text="拖动顶部标题栏移动窗口；切换背景材质；开新窗口（同一 UI 线程）。"/>
        </StackPanel>
    </Grid>
</Window>
