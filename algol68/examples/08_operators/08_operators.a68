# 08 · 运算符与优先级：OP/PRIO 自定义、一元/二元、为重载、优先级 1..9 #
BEGIN
  INT fails := 0;
  PROC assert = (BOOL cond, STRING msg) VOID:
    IF NOT cond THEN put(stand error, ("FAIL: ", msg, new line)); fails +:= 1 FI;

  # ═══ 8.1 自定义二元运算符：先 PRIO 定优先级，再 OP 定实现 ═══ #
  # 可用符号：% & ! ? ^ ~ 以及多字符如 <> == ** ；也可用大写字母串（如 DOT）。 #
  # 坑：$ 和 | 是 transput/格式专用，不能当运算符；优先级只能是 1..9。 #
  PRIO DOT = 7;
  OP DOT = (INT a, b) INT: a * b + 1;
  print(("3 DOT 4 = ", whole(3 DOT 4, 0), "  (定义为 a*b+1)", new line));
  assert(3 DOT 4 = 13, "DOT 自定义运算");

  # ═══ 8.2 自定义一元（monadic）运算符 ═══ #
  PRIO SQ = 9;                       # 一元运算符优先级要高（绑得紧） #
  OP SQ = (INT a) INT: a * a;
  print(("SQ 5 = ", whole(SQ 5, 0), new line));
  assert(SQ 5 = 25, "一元平方");

  # ═══ 8.3 优先级决定结合：高优先级先算 ═══ #
  # DOT 优先级 7，内置 * 是 7，+ 是 6。看 PRIO 怎么影响解析。 #
  PRIO PLUSTWICE = 5;                # 比 + (6) 还低 #
  OP PLUSTWICE = (INT a, b) INT: a + b + b;
  print(("2 PLUSTWICE 3 = ", whole(2 PLUSTWICE 3, 0), "  (a+b+b)", new line));
  assert(2 PLUSTWICE 3 = 8, "低优先级自定义算符");

  # ═══ 8.4 为新模「重载」已有运算符：让 + * 作用于 STRUCT ═══ #
  MODE VEC = STRUCT(INT x, y);
  OP + = (VEC a, b) VEC: (x OF a + x OF b, y OF a + y OF b);
  OP * = (INT k, VEC v) VEC: (k * x OF v, k * y OF v);
  VEC v1 := (1, 2), v2 := (3, 4);
  VEC sum := v1 + v2;
  VEC scaled := 3 * v1;
  print(("v1 + v2 = (", whole(x OF sum, 0), ",", whole(y OF sum, 0), ")", new line));
  print(("3 * v1  = (", whole(x OF scaled, 0), ",", whole(y OF scaled, 0), ")", new line));
  assert(x OF sum = 4 AND y OF sum = 6, "向量加法");
  assert(x OF scaled = 3 AND y OF scaled = 6, "标量乘法");

  # ═══ 8.5 运算符就是「带符号名的过程」：可让 OP 委托给一个 PROC ═══ #
  PROC dot_impl = (INT a, b) INT: a * b + 1;
  PRIO DOTP = 7;
  OP DOTP = (INT a, b) INT: dot_impl(a, b);   # 运算符体里调用普通过程 #
  print(("3 DOTP 4 = ", whole(3 DOTP 4, 0), "   dot_impl(3,4) = ",
         whole(dot_impl(3, 4), 0), new line));
  assert(3 DOTP 4 = dot_impl(3, 4), "运算符与过程同源");

  # ═══ 8.6 坑（实测）：重定义已有运算符时，函数体里别再用同名运算符 ═══ #
  # 例如 OP ** = (INT a,b) REAL: a ** b; —— 体里的 a**b 又调用自己， #
  # 实测直接 stack overflow（无限递归）。要复用旧语义请先存进过程或换名。 #
  print(("提示：重载 ** 却在体里写 a ** b 会无限递归 → stack overflow", new line));

  print(("==== 08 结束 ====", new line));
  IF fails > 0 THEN print(("自检失败 ", fails, " 项", new line))
  ELSE print(("自检全部通过", new line)) FI
END
