// ═══ 19.1 布局系统：三种布局盒 + 约束 ═══
// Slint 布局 = VerticalLayout / HorizontalLayout / GridLayout 三件套，
// 子元素用 min-width/max-width/horizontal-stretch 参与分空间谈判。

import { Button } from "std-widgets.slint";

export component LayoutLab inherits Window {
    title: "19 slint layout";
    preferred-width: 480px;
    preferred-height: 360px;

    in-out property <int> clicked: 0;
    callback click(string);

    VerticalLayout {
        padding: 16px;
        spacing: 12px;

        // ---- 三栏：水平布局 + 弹性权重 ----
        HorizontalLayout {
            spacing: 8px;
            // 定宽栏
            left-pane := Rectangle {
                width: 120px;
                background: #253;
                Text { text: "定宽 120"; color: white; }
            }
            // 弹性 2 份
            center-pane := Rectangle {
                horizontal-stretch: 2;
                background: #345;
                Text { text: "弹性 2"; color: white; }
            }
            // 弹性 1 份
            right-pane := Rectangle {
                horizontal-stretch: 1;
                background: #456;
                Text { text: "弹性 1"; color: white; }
            }
        }

        // ---- 网格：表单两列对齐 ----
        GridLayout {
            spacing: 8px;
            Row {
                label-a := Text { text: "姓名："; }
                field-a := Rectangle {
                    background: #eee;
                    height: 32px;
                    Text { text: "张三"; }
                }
            }
            Row {
                label-b := Text { text: "城市："; }
                field-b := Rectangle {
                    background: #eee;
                    height: 32px;
                    Text { text: "深圳"; }
                }
            }
        }

        // ---- 对齐属性演示 ----
        HorizontalLayout {
            alignment: center;   // start/center/end/space-between
            Button {
                text: "点我";
                clicked => { root.click("hit"); }
            }
        }
    }
}
