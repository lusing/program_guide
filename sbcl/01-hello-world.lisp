;;;; ============================================================
;;;; 01-hello-world.lisp — SBCL 基础入门
;;;; ============================================================
;;;;
;;;; 本例程演示：
;;;;   1. 最简单的 Hello World
;;;;   2. 在 REPL 中交互式求值
;;;;   3. 以脚本方式运行 Lisp 文件
;;;;   4. 编译并生成可执行文件（core dump 方式）
;;;;
;;;; 运行方式：
;;;;   方式 A — 在 REPL 中加载：
;;;;     sbcl --load 01-hello-world.lisp
;;;;
;;;;   方式 B — 作为脚本执行（需要脚本头）：
;;;;     sbcl --script 01-hello-world.lisp
;;;;
;;;;   方式 C — 编译后加载：
;;;;     sbcl --eval '(compile-file "01-hello-world.lisp")' \
;;;;          --eval '(load "01-hello-world.fasl")' --quit
;;;; ============================================================


;;; ----------------------------------------------------------
;;; 1. 最简单的 Hello World
;;; ----------------------------------------------------------

;; format 是 Common Lisp 中最常用的输出函数
;; 第一个参数 t 表示输出到 *standard-output*（标准输出）
;; "~%" 是换行指令
(format t "Hello, World!~%")

;; print 会在输出前后自动加换行，并返回值本身
(print "Hello from print")

;; princ 输出不带引号的字符串（更适合人类阅读）
(princ "Hello from princ")
(terpri)  ; terpri = terminate print line，即输出一个换行

;; prin1 输出带引号的字符串（保留可读性，可被 read 读回）
(prin1 "Hello from prin1")
(terpri)


;;; ----------------------------------------------------------
;;; 2. 定义一个简单的函数并调用
;;; ----------------------------------------------------------

(defun greet (name)
  "向 NAME 打招呼。文档字符串（docstring）写在参数列表之后。"
  (format t "你好，~A！欢迎来到 SBCL 世界。~%" name))

;; 调用函数
(greet "Lisper")
(greet "世界")


;;; ----------------------------------------------------------
;;; 3. 顶层表达式会按顺序依次求值
;;; ----------------------------------------------------------

;; Lisp 文件被 load 时，其中的顶层表达式会逐个求值
(let ((x 10)
      (y 20))
  (format t "x + y = ~A~%" (+ x y)))


;;; ----------------------------------------------------------
;;; 4. 以脚本方式运行（--script 模式）
;;; ----------------------------------------------------------
;;;;
;;;; 当使用 sbcl --script 运行时：
;;;;   - 不会进入 REPL
;;;;   - 不会加载 ~/.sbclrc 初始化文件
;;;;   - 顶层表达式依次执行完毕后自动退出
;;;;
;;;; 如果希望文件既可以被 load 又可以作为脚本运行，
;;;; 可以判断 *load-pathname* 或添加脚本头：
;;;;   #!/usr/bin/env sbcl --script


;;; ----------------------------------------------------------
;;; 5. 生成独立可执行文件（SBCL 特有功能）
;;; ----------------------------------------------------------
;;;;
;;;; SBCL 可以将当前 Lisp 映像保存为可执行文件：
;;;;
;;;;   (sb-ext:save-lisp-and-die "hello-app"
;;;;                             :toplevel #'main
;;;;                             :executable t)
;;;;
;;;; 产物名在 Windows 上习惯写 hello-app.exe，macOS/Linux 上无扩展名。
;;;; 完整示例（取消注释后，在 REPL 中 load 本文件即可生成）：

;; (defun main ()
;;   (format t "这是独立可执行文件！~%")
;;   (greet "独立程序")
;;   (sb-ext:quit))  ; 退出，返回码 0
;;
;; (sb-ext:save-lisp-and-die "hello-app"
;;                           :toplevel #'main
;;                           :executable t)


;;; ----------------------------------------------------------
;;; 6. 获取命令行参数（SBCL 特有）
;;; ----------------------------------------------------------

;; sb-ext:*posix-argv* 包含命令行参数列表
;; 第一个元素是程序名，其余是参数
(format t "命令行参数: ~S~%" sb-ext:*posix-argv*)


;;; ----------------------------------------------------------
;;; 7. 退出程序
;;; ----------------------------------------------------------

;; sb-ext:quit 退出 SBCL，可指定返回码
;; (sb-ext:quit :unix-status 0)

(format t "~%==== 01 结束 ====~%")
