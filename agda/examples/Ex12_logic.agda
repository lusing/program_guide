------------------------------------------------------------------------
-- 第 12 章示例：逻辑连接词
--
-- Curry–Howard 落地：⊤ ⊥ ¬ × Σ ⊎ → ∀ ∃ 的引入/消去规则全部写成真实证明；
-- stdlib 各连接词的真实住址；排中律作为 postulate 与 --safe 的冲突。
--
-- 类型检查：cd agda && agda examples/Ex12_logic.agda
------------------------------------------------------------------------

module Ex12_logic where

open import Data.Empty using (⊥; ⊥-elim)
open import Data.Unit using (⊤; tt)
open import Data.Sum using (_⊎_; inj₁; inj₂; [_,_])
open import Data.Product
  using (_×_; _,_; proj₁; proj₂; ∃; ∃-syntax; Σ; Σ-syntax)
open import Relation.Nullary using (¬_; Dec; yes; no)
open import Function using (_∘_)
open import Relation.Binary.PropositionalEquality
  using (_≡_; refl; _≢_)
open import Data.Nat using (ℕ; zero; suc; _+_)

------------------------------------------------------------------------
-- 12.1 真与假：⊤（record）与 ⊥（零构造子 data）
------------------------------------------------------------------------

-- ⊤ 的引入：唯一构造子 tt（Agda.Builtin.Unit：record ⊤ : Set where tt）
⊤-intro : ⊤
⊤-intro = tt

-- record 自带 η：⊤ 的任意元素「就是」tt，一条 refl 证尽天下真命题
⊤-η : ∀ (x : ⊤) → x ≡ tt
⊤-η x = refl

-- ⊥ 的消去（爆炸律）：没有构造子 ⇒ 一个分支都不用写
⊥-elim′ : ∀ {A : Set} → ⊥ → A
⊥-elim′ ()

------------------------------------------------------------------------
-- 12.2 合取 ×：引入是逗号，消去是投影
------------------------------------------------------------------------

-- 引入
3-+3-is-6 : (3 + 3 ≡ 6) × (2 + 2 ≡ 4)
3-+3-is-6 = refl , refl

-- 消去（∧-elim 左右各一）
∧-elimˡ : ∀ {A B : Set} → A × B → A
∧-elimˡ = proj₁

∧-elimʳ : ∀ {A B : Set} → A × B → B
∧-elimʳ = proj₂

×-comm : ∀ {A B : Set} → A × B → B × A
×-comm (a , b) = b , a

------------------------------------------------------------------------
-- 12.3 × 与 Σ 之辨：非依赖对 = 第二参数不依赖第一参数的 Σ
-- （stdlib：Data.Product.Base 第 71 行  A × B = Σ[ x ∈ A ] B）
------------------------------------------------------------------------

×→Σ : ∀ {A B : Set} → A × B → Σ[ x ∈ A ] B
×→Σ (a , b) = a , b

Σ→× : ∀ {A B : Set} → Σ[ x ∈ A ] B → A × B
Σ→× (a , b) = a , b

-- 真正依赖「第一个分量的值」的配对，× 装不下、Σ 可以
∃-witness : Σ[ n ∈ ℕ ] n + n ≡ 4
∃-witness = 2 , refl

------------------------------------------------------------------------
-- 12.4 存在 ∃：Σ 的谓词特例（∃-syntax：∃[ x ] P x）
------------------------------------------------------------------------

∃-intro : ∃[ n ] n + n ≡ 4
∃-intro = 2 , refl                   -- 引入 = 交出见证 + 性质证明

∃-elim : ∀ {A : Set} {P : A → Set} {C : Set}
        → ∃[ x ] P x → (∀ {x} → P x → C) → C
∃-elim (x , px) f = f px             -- 消去 = 对见证与证明同时 case

------------------------------------------------------------------------
-- 12.5 析取 ⊎：两个注入标签 + 情形证明
------------------------------------------------------------------------

-- 2 是偶数「或」3 是奇数：选边即证（构造性 ∨ 自带“我知道哪边成立”）
or-demo : (∃[ n ] n + n ≡ 2) ⊎ (∃[ n ] suc (n + n) ≡ 3)
or-demo = inj₁ (1 , refl)

⊎-comm : ∀ {A B : Set} → A ⊎ B → B ⊎ A
⊎-comm (inj₁ a) = inj₂ a
⊎-comm (inj₂ b) = inj₁ b

-- ∨-消去（情形证明）：两条各归各的函数，[ f , g ] 并成一件事
∨-elim : ∀ {A B C : Set} → A ⊎ B → (A → C) → (B → C) → C
∨-elim (inj₁ a) f _ = f a
∨-elim (inj₂ b) _ g = g b

∨-elim′ : ∀ {A B C : Set} → (A → C) → (B → C) → A ⊎ B → C
∨-elim′ f g = [ f , g ]

-- 分配律：两个方向一个免费一个要见证（反面构造上成立）
distʳ→ : ∀ {A B C : Set} → (A × C) ⊎ (B × C) → (A ⊎ B) × C
distʳ→ (inj₁ (a , c)) = inj₁ a , c
distʳ→ (inj₂ (b , c)) = inj₂ b , c

distˡ← : ∀ {A B C : Set} → (A ⊎ B) × C → (A × C) ⊎ (B × C)
distˡ← (inj₁ a , c) = inj₁ (a , c)
distˡ← (inj₂ b , c) = inj₂ (b , c)

------------------------------------------------------------------------
-- 12.6 否定 ¬A = A → ⊥：证伪 = 交出「吃假设」的函数
------------------------------------------------------------------------

-- 0 ≢ 1 展开即 (0 ≡ 1) → ⊥：等式两端构造子不兼容 ⇒ 零分支搞定
0≢1 : 0 ≢ 1
0≢1 ()

-- 「A 且 ¬A」必假：这就是 stdlib 的 contradiction（Negation.Core 第 53 行）
contra-demo : ∀ {A : Set} → A → ¬ A → ⊥
contra-demo a ¬a = ¬a a

-- ⊥ 消灭一切：荒谬分支里连函数体都不用给
¬-streng : ∀ {A B : Set} → ¬ A → A × B → ⊥
¬-streng ¬a (a , b) = ¬a a

------------------------------------------------------------------------
-- 12.7 双重否定：→→ 方向构造可证，←← 方向要请公理
------------------------------------------------------------------------

¬¬-intro : ∀ {A : Set} → A → ¬ ¬ A
¬¬-intro a ¬na = ¬na a             -- 纯 λ：A 的消费者见到 ¬A 当场爆炸

-- 逆命题「¬¬A → A」（DNE）构造上写不出：洞 _ 无解（实测 UnsolvedMetas）。
-- 加上排中律公理才通——见 12.8；stdlib 对应 Axiom.DoubleNegationElimination。

------------------------------------------------------------------------
-- 12.8 排中律：作为 postulate 的公理（本文件未加 --safe，所以放行）
------------------------------------------------------------------------

postulate
  LEM : ∀ {A : Set} → A ⊎ ¬ A       -- 经典逻辑：每命题「或真或假」的证词

-- 由 LEM 得到 ¬¬-elim：分情形，真就直接交，假就爆炸
¬¬-elim : ∀ {A : Set} → ¬ ¬ A → A
¬¬-elim {A = A} ¬¬a with LEM {A}
¬¬-elim ¬¬a | inj₁ a = a
¬¬-elim ¬¬a | inj₂ ¬a = ⊥-elim (¬¬a ¬a)

-- 皮尔士定律：同样靠 LEM 一步到位
peirce : ∀ {A B : Set} → ((A → B) → A) → A
peirce {A} {B} f with LEM {A}
peirce f | inj₁ a = a
peirce f | inj₂ ¬a = f (λ a → ⊥-elim (¬a a))

-- De Morgan 一边构造可证；「¬(A × B) → ¬A ⊎ ¬B」反向要 LEM（正文演示方向）
dm₁ : ∀ {A B : Set} → (¬ A ⊎ ¬ B) → ¬ (A × B)
dm₁ (inj₁ ¬a) (a , b) = ¬a a
dm₁ (inj₂ ¬b) (a , b) = ¬b b

dm₂ : ∀ {A B : Set} → ¬ (A ⊎ B) → ¬ A × ¬ B
dm₂ ¬[A⊎B] = (λ a → ¬[A⊎B] (inj₁ a)) , (λ b → ¬[A⊎B] (inj₂ b))

------------------------------------------------------------------------
-- 12.9 蕴含与等价：→ 就是函数，⇔ 是一对往返
------------------------------------------------------------------------

modus-ponens : ∀ {A B : Set} → (A → B) → A → B
modus-ponens f a = f a              -- 「蕴含消去」= 函数应用，零技巧

infixr 1 _⇔_
_⇔_ : Set → Set → Set
A ⇔ B = (A → B) × (B → A)          -- 等价 = 双向蕴含（stdlib 用 record，17 章）

⇔-sym : ∀ {A B : Set} → A ⇔ B → B ⇔ A
⇔-sym (f , g) = g , f

------------------------------------------------------------------------
-- 12.10 量词与全称：∀ 是依赖函数、∃ 是依赖对（15 章「判定」预告）
------------------------------------------------------------------------

∀-intro : ∀ (n : ℕ) → n ≡ n
∀-intro n = refl                     -- 证「对所有 n」= 给一个吃 n 的函数

-- 全称对合取的分配（构造可证）
∀-distrib-× : ∀ {A : Set} {P Q : A → Set} → (∀ x → P x × Q x) → (∀ x → P x) × (∀ x → Q x)
∀-distrib-× h = (proj₁ ∘ h) , (proj₂ ∘ h)

-- 判定性 Dec：A ⊎ ¬A 的「可计算版」——不是每命题都造得出这台机器（15 章）
⊤-dec : Dec ⊤
⊤-dec = yes tt

⊥-dec : Dec ⊥
⊥-dec = no ⊥-elim

-- 「∀ 对析取的反分配」构造不出（需选择+判定），这里只立起可证的一边：
¬∃→∀¬ : ∀ {A : Set} {P : A → Set} → ¬ (∃[ x ] P x) → ∀ x → ¬ (P x)
¬∃→∀¬ ¬∃ x px = ¬∃ (x , px)
