        <view contentMode="scaleToFill" id="xRoot">
            <rect key="frame" x="0.0" y="0.0" width="280.0" height="120.0"/>
            <autoresizingMask key="autoresizingMask" flexibleMaxX="YES" flexibleMaxY="YES"/>
            <subviews>
                <label opaque="NO" userInteractionEnabled="NO" contentMode="left" horizontalHuggingPriority="251" verticalHuggingPriority="251" text="卡片标题" textAlignment="natural" lineBreakMode="tailClipping" baselineAdjustment="alignBaselines" adjustsFontSizeToFit="NO" id="xTitle" customClass="CardLabel" customModule="interface_builder">
                    <rect key="frame" x="16.0" y="16.0" width="248.0" height="28.0"/>
