<?xml version="1.0" encoding="UTF-8"?>
<document type="com.apple.InterfaceBuilder3.CocoaTouch.Storyboard.XIB" version="3.0" toolsVersion="17150" targetRuntime="iOS.CocoaTouch" propertyAccessControl="none" useAutolayout="YES" useTraitCollections="YES" useSafeAreas="YES" colorMatched="YES" initialViewController="ENT-01-001">
    <dependencies>
        <plugIn identifier="com.apple.InterfaceBuilder.IBCocoaTouchPlugin" version="17122"/>
        <capability name="Safe area layout guides" minToolsVersion="9.0"/>
        <capability name="documents saved in the Xcode 8 format" minToolsVersion="8.0"/>
    </dependencies>
    <scenes>
        <!--Entry-->
        <scene sceneID="scEntry">
            <objects>
                <viewController id="ENT-01-001" sceneMemberID="viewController" customClass="EntryVC" customModule="interface_builder">
                    <view key="view" contentMode="scaleToFill" id="vEnt">
                        <rect key="frame" x="0.0" y="0.0" width="414" height="896"/>
                        <autoresizingMask key="autoresizingMask" widthSizable="YES" heightSizable="YES"/>
                        <subviews>
                            <label opaque="NO" userInteractionEnabled="NO" contentMode="left" horizontalHuggingPriority="251" verticalHuggingPriority="251" text="欢迎" textAlignment="natural" lineBreakMode="tailClipping" baselineAdjustment="alignBaselines" adjustsFontSizeToFit="NO" id="lblTitle">
                                <rect key="frame" x="24.0" y="120.0" width="200.0" height="44.0"/>
                                <autoresizingMask key="autoresizingMask" flexibleMaxX="YES" flexibleMaxY="YES"/>
                                <fontDescription key="fontDescription" type="boldSystem" pointSize="24"/>
                                <nil key="textColor"/>
                                <nil key="highlightedColor"/>
                            </label>
                            <button opaque="NO" contentMode="scaleToFill" contentHorizontalAlignment="center" contentVerticalAlignment="center" buttonType="system" lineBreakMode="middleTruncation" id="btnTap">
                                <rect key="frame" x="24.0" y="200.0" width="160.0" height="44.0"/>
                                <autoresizingMask key="autoresizingMask" flexibleMaxX="YES" flexibleMaxY="YES"/>
                                <state key="normal" title="点我"/>
                                <connections>
                                    <action selector="didTap:" destination="ENT-01-001" eventType="touchUpInside" id="actTap"/>
                                </connections>
                            </button>
                            <button opaque="NO" contentMode="scaleToFill" contentHorizontalAlignment="center" contentVerticalAlignment="center" buttonType="system" lineBreakMode="middleTruncation" id="btnSegue">
                                <rect key="frame" x="24.0" y="260.0" width="160.0" height="44.0"/>
                                <autoresizingMask key="autoresizingMask" flexibleMaxX="YES" flexibleMaxY="YES"/>
                                <state key="normal" title="去第二页"/>
                                <connections>
                                    <segue destination="SEC-02-002" kind="show" identifier="byeButton" animates="NO" id="sgBtn"/>
                                </connections>
                            </button>
                            <imageView clipsSubviews="YES" userInteractionEnabled="NO" contentMode="scaleAspectFit" horizontalHuggingPriority="251" verticalHuggingPriority="251" image="pip" id="imgPip">
                                <rect key="frame" x="24.0" y="330.0" width="48.0" height="48.0"/>
                                <autoresizingMask key="autoresizingMask" flexibleMaxX="YES" flexibleMaxY="YES"/>
                            </imageView>
                        </subviews>
                        <viewLayoutGuide key="safeArea" id="saEnt"/>
                        <color key="backgroundColor" red="1" green="1" blue="1" alpha="1" colorSpace="custom" customColorSpace="sRGB"/>
                        <constraints>
                            <constraint firstItem="lblTitle" firstAttribute="leading" secondItem="saEnt" secondAttribute="leading" constant="24" id="cLead"/>
                            <constraint firstItem="lblTitle" firstAttribute="top" secondItem="saEnt" secondAttribute="top" constant="100" id="cTop"/>
                        </constraints>
                    </view>
                    <userDefinedRuntimeAttributes>
                        <userDefinedRuntimeAttribute type="number" keyPath="badge">
                            <real key="value" value="7"/>
                        </userDefinedRuntimeAttribute>
                        <userDefinedRuntimeAttribute type="string" keyPath="caption">
                            <string key="value">故事板填进来的标题</string>
                        </userDefinedRuntimeAttribute>
                        <userDefinedRuntimeAttribute type="boolean" keyPath="flagged" value="YES"/>
                    </userDefinedRuntimeAttributes>
                    <connections>
                        <outlet property="titleLabel" destination="lblTitle" id="olTitle"/>
                        <outlet property="tapButton" destination="btnTap" id="olTap"/>
                        <outlet property="segueButton" destination="btnSegue" id="olSegueBtn"/>
                        <outlet property="pipView" destination="imgPip" id="olPip"/>
                        <outlet property="titleLeading" destination="cLead" id="olLead"/>
                    </connections>
                </viewController>
                <placeholder placeholderIdentifier="IBFirstResponder" id="frEnt" userLabel="First Responder" customClass="UIResponder" sceneMemberID="firstResponder"/>
            </objects>
            <point key="canvasLocation" x="0.0" y="0.0"/>
        </scene>
        <!--Second-->
        <scene sceneID="scSecond">
            <objects>
                <viewController id="SEC-02-002" sceneMemberID="viewController" customClass="SecondVC" customModule="interface_builder" storyboardIdentifier="TheSecond">
                    <view key="view" contentMode="scaleToFill" id="vSec">
                        <rect key="frame" x="0.0" y="0.0" width="414" height="896"/>
                        <autoresizingMask key="autoresizingMask" widthSizable="YES" heightSizable="YES"/>
                        <subviews>
                            <label opaque="NO" userInteractionEnabled="NO" contentMode="left" horizontalHuggingPriority="251" verticalHuggingPriority="251" text="第二页" textAlignment="natural" lineBreakMode="tailClipping" baselineAdjustment="alignBaselines" adjustsFontSizeToFit="NO" id="lblSec">
                                <rect key="frame" x="24.0" y="120.0" width="200.0" height="30.0"/>
                                <autoresizingMask key="autoresizingMask" flexibleMaxX="YES" flexibleMaxY="YES"/>
                                <fontDescription key="fontDescription" type="system" pointSize="17"/>
                                <nil key="textColor"/>
                                <nil key="highlightedColor"/>
                            </label>
                        </subviews>
                        <viewLayoutGuide key="safeArea" id="saSec"/>
                        <color key="backgroundColor" red="0.92" green="0.94" blue="1" alpha="1" colorSpace="custom" customColorSpace="sRGB"/>
                    </view>
                    <userDefinedRuntimeAttributes>
                        <userDefinedRuntimeAttribute type="string" keyPath="title" value="第二页的标题"/>
                    </userDefinedRuntimeAttributes>
                    <connections>
                        <outlet property="messageLabel" destination="lblSec" id="olSec"/>
                    </connections>
                </viewController>
                <placeholder placeholderIdentifier="IBFirstResponder" id="frSec" userLabel="First Responder" customClass="UIResponder" sceneMemberID="firstResponder"/>
            </objects>
            <point key="canvasLocation" x="400.0" y="0.0"/>
        </scene>
        <!--Plain-->
        <scene sceneID="scPlain">
            <objects>
                <viewController id="PLN-03-003" sceneMemberID="viewController" storyboardIdentifier="PlainScreen">
                    <view key="view" contentMode="scaleToFill" id="vPln">
                        <rect key="frame" x="0.0" y="0.0" width="414" height="896"/>
                        <autoresizingMask key="autoresizingMask" widthSizable="YES" heightSizable="YES"/>
                        <viewLayoutGuide key="safeArea" id="saPln"/>
                    </view>
                </viewController>
                <placeholder placeholderIdentifier="IBFirstResponder" id="frPln" userLabel="First Responder" customClass="UIResponder" sceneMemberID="firstResponder"/>
            </objects>
            <point key="canvasLocation" x="800.0" y="0.0"/>
        </scene>
    </scenes>
    <resources>
        <image name="pip" width="4" height="4"/>
    </resources>
</document>
