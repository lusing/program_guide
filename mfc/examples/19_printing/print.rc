// 19_printing 的资源脚本。
// 打印三命令（打印/预览/设置）的 ID_FILE_* 由 CView/CWinApp 的标准实现
// 处理 —— 菜单摆上 ID 就能用，一行处理代码都不用写。
#pragma code_page(65001)

#include "resource.h"
#include "afxres.h"

IDR_MAINFRAME MENU
BEGIN
    POPUP "文件(&F)"
    BEGIN
        MENUITEM "新建(&N)\tCtrl+N",            ID_FILE_NEW
        MENUITEM SEPARATOR
        MENUITEM "打印(&P)\tCtrl+P",            ID_FILE_PRINT
        MENUITEM "打印预览(&V)",                ID_FILE_PRINT_PREVIEW
        MENUITEM "打印设置(&R)...",             ID_FILE_PRINT_SETUP
        MENUITEM SEPARATOR
        MENUITEM "退出(&X)",                    ID_APP_EXIT
    END
END

IDR_MAINFRAME ACCELERATORS
BEGIN
    "N", ID_FILE_NEW,    VIRTKEY, CONTROL
    "P", ID_FILE_PRINT,  VIRTKEY, CONTROL
END

// 9 字段串：1标题 2文档名 3新建默认名 4过滤器名 5过滤器
//           6默认扩展名 7注册表类型ID 8注册表类型名 9新文件过滤器名
STRINGTABLE
BEGIN
    IDR_MAINFRAME "销售报表\n报表\n报表\n\n\n\nReport.Document\n报表文档\n报表"
END
