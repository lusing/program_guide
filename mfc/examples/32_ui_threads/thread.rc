// UI 线程资源
#pragma code_page(65001)

#include "resource.h"
#include <afxres.h>

IDD_MAIN DIALOGEX 0, 0, 480, 320
STYLE DS_SETFONT | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU | WS_MINIMIZEBOX
CAPTION "第 32 章 · UI 线程：CWinThread 自有窗口 / 线程间消息 / 竞争与锁"
FONT 9, "Microsoft YaHei UI", 400, 0, 0x1
BEGIN
    PUSHBUTTON      "启动 UI 线程(监视器窗口)", IDC_BTN_START_UI, 10, 10, 150, 22
    PUSHBUTTON      "停止 UI 线程", IDC_BTN_STOP_UI, 165, 10, 110, 22
    PUSHBUTTON      "派任务给它", IDC_BTN_POST_THREAD, 280, 10, 110, 22
    PUSHBUTTON      "优先级实验", IDC_BTN_PRIORITY, 395, 10, 75, 22
    PUSHBUTTON      "无锁竞争(丢计数)", IDC_BTN_RACE_ON, 10, 36, 150, 22
    PUSHBUTTON      "CMutex 修正(不丢)", IDC_BTN_RACE_OFF, 165, 36, 150, 22
    EDITTEXT        IDC_EDIT_LOG, 10, 66, 460, 210, ES_MULTILINE | ES_AUTOVSCROLL | ES_READONLY | WS_VSCROLL
    LTEXT           "UI 线程 = 有自己消息循环的线程：能建窗口、收消息；worker 线程只是跑函数（第 20 章）", -1, 10, 282, 460, 16
END
