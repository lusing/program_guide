#pragma code_page(65001)

#include "resource.h"
#include "afxres.h"

IDR_MAIN_MENU MENU
BEGIN
    POPUP "文件(&F)"
    BEGIN
        MENUITEM "打开(&O)...\tCtrl+O", IDM_FILE_OPEN
        MENUITEM "保存(&S)...\tCtrl+S", IDM_FILE_SAVE
        MENUITEM SEPARATOR
        MENUITEM "退出(&X)",            IDM_FILE_EXIT
    END
    POPUP "格式(&T)"
    BEGIN
        MENUITEM "文字颜色(&C)...",     IDM_FMT_COLOR
    END
END

// 菜单项文本里标了 Ctrl+O / Ctrl+S，就必须有这张加速键表来兑现它。
// 与菜单共用 IDR_MAIN_MENU（资源 ID 按类型区分，同名不冲突）。
IDR_MAIN_MENU ACCELERATORS
BEGIN
    "O",    IDM_FILE_OPEN,  VIRTKEY, CONTROL
    "S",    IDM_FILE_SAVE,  VIRTKEY, CONTROL
END
