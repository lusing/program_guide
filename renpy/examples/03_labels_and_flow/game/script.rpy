# =============================================================================
# 第 5 章　标签与控制流
# -----------------------------------------------------------------------------
# 本章讲「故事怎么走」：标签(label)是落脚点，jump/call 负责转移控制权。
# 一句话记忆：
#   jump → 一去不回（不记录回来的位置）
#   call → 去子程序办事，办完 return 回到原地
# 为了不抢第 6 章的戏，本文件完全不用 menu（菜单）。
# =============================================================================


# -----------------------------------------------------------------------------
# 1. 角色
# -----------------------------------------------------------------------------
define e = Character("艾琳", who_color="#c8ffc8")


# -----------------------------------------------------------------------------
# 2. 入口：start 标签里的「线性流程 + 调用 + 跳转」
# -----------------------------------------------------------------------------
label start:

    # 进入 start 后，语句自上而下顺序执行。
    "（旁白）这里是 start 标签，语句会从上到下顺序执行。"

    # call：把控制权交给 greet，并在「调用栈」里记住自己的位置。
    # 后面那个 from 子句（_call_greet_1）是「返回位置的标签名」。
    "（旁白）先调用带参数的子程序 greet，办完它会 return 回来。"
    call greet("世界") from _call_greet_1
    "（旁白）瞧，call 返回后又回到这里，接着往下走。"

    # while 循环：用 $ 修改计数器，条件为假时退出循环。
    "（旁白）再用 while 循环倒数，计数器用 $ 修改。"
    $ count = 3
    while count > 0:
        e "倒数 [count] ……"
        $ count -= 1
    e "点火！"

    # call expression：要调用的标签名放在变量里，运行时才决定叫谁。
    "（旁白）接下来演示 call expression：标签名放在变量里。"
    $ target = "farewell"
    call expression target from _call_expr_1
    "（旁白）上面那条就是 call expression 的用法。"

    # jump：直接跳走，不记录回来的位置，所以后面这句永远不会执行。
    "（旁白）最后用 jump 跳到 check_score——注意 jump 不会回来。"
    jump check_score


# -----------------------------------------------------------------------------
# 3. 带参数的子程序 greet
# -----------------------------------------------------------------------------
# 标签可以带参数；给参数一个默认值（name="世界"），不传也能调用。
# 标签里的 return 会把控制权交还给「调用它的那条 call」后面。
label greet(name="世界"):
    e "你好，[name]！我是艾琳。"
    e "（这段属于 greet 标签，执行完会自动 return 回去。）"
    return


# -----------------------------------------------------------------------------
# 4. call expression 的目标标签 farewell
# -----------------------------------------------------------------------------
label farewell:
    "（旁白）farewell 是被 call expression 调用的，现在又返回去了。"
    return


# -----------------------------------------------------------------------------
# 5. 用 if / else 决定 jump 的去向
# -----------------------------------------------------------------------------
# 这里的分支只有一个目的：让 jump「有的选」，跳向不同结局。
label check_score:
    $ score = 7
    "（旁白）这是 check_score 标签，用 if / else 选择不同结局。"
    if score >= 5:
        "（旁白）分数 [score]，合格。"
        jump ending_good
    else:
        "（旁白）分数 [score]，不合格。"
        jump ending_bad


# -----------------------------------------------------------------------------
# 6. 两个结局标签
# -----------------------------------------------------------------------------
# 因为是用 jump 过来的，所以结局里不需要（也不会）回到 check_score。
label ending_good:
    "（旁白）好结局。既然是 jump 过来的，就不会回到 check_score。"
    return


label ending_bad:
    "（旁白）坏结局。"
    return
