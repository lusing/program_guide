# ============================================================
# 示例 06 · NVL 模式                      （配套第 8 章）
#
# NVL 模式（Novel 模式）会把多句台词堆叠在同一屏上，
# 像小说页面一样逐行累积，需要通过 nvl clear 手动翻页。
#
# 本示例演示：
#   - 用 kind=nvl 定义叙述者与具名角色
#   - 与普通 ADV 角色混用，直观对比两者区别
#   - nvl clear 翻页、nvl show / nvl hide 切换窗口
#   - 在 NVL 段落中插入一次 menu
# ============================================================


# ------------------------------------------------------------
# 1. NVL 角色定义
#    给 Character 加上 kind=nvl，这个角色就会使用 NVL 模式。
#    name 为 None 时即为「无名叙述者」，相当于小说里的旁白。
# ------------------------------------------------------------
define narrator = Character(None, kind=nvl)
define a = Character("艾琳", kind=nvl)

# ------------------------------------------------------------
# 2. 一个普通的 ADV 角色，用来对比两种模式的区别
#    ADV 角色每说一句都会清掉上一句，只保留当前这一句。
# ------------------------------------------------------------
define b = Character("贝尔")

# ------------------------------------------------------------
# 3. 内建可视化：用纯色块当背景，并用文本对象提示当前模式
# ------------------------------------------------------------
image bg_nvl = Solid("#141018")
image tag_nvl = Text("NVL 模式", size=26, color="#d8c8ff")


label start:

    # 3.1 铺好背景
    scene bg_nvl
    show tag_nvl at topleft
    with fade

    # --------------------------------------------------------
    # 4. NVL 正文：台词会一页页累积在同一屏上
    #    这里 narrator / a 都是 NVL 角色，它们的台词会叠加显示。
    # --------------------------------------------------------
    narrator "（这一屏是 NVL 模式。旁白和角色的话会一行行累积在屏幕上。）"
    narrator "（雨停之后，旧书店的灯还亮着。）"
    a "你终于来了。"
    a "我一直在等你翻到这一页。"
    narrator "（看得出来，她并没有在开玩笑。）"

    # --------------------------------------------------------
    # 5. nvl clear：清空当前页面，开始新的一页
    #    如果不翻页，台词会一直往下加，最终溢出屏幕。
    # --------------------------------------------------------
    nvl clear

    narrator "（这是翻页后的新一页。）"
    a "我们从头说起吧——"

    # --------------------------------------------------------
    # 6. 在 NVL 段落里插入 menu
    #    这里的 menu 使用默认的 ADV 呈现（浮在整屏之上），
    #    选择之后 NVL 页面会继续累积。
    # --------------------------------------------------------
    menu:
        "认真听她说":
            a "很好，你没有插嘴。"
        "打断她":
            a "……好吧，那我们从另一头讲起。"

    narrator "（无论选哪一项，故事都会继续。）"

    # --------------------------------------------------------
    # 7. nvl hide / nvl show：临时收起或重新显示 NVL 窗口
    #    可以带一个转场（这里用 dissolve）。
    # --------------------------------------------------------
    nvl hide dissolve
    narrator "（此刻 NVL 窗口被隐藏，屏幕上只剩背景。）"
    nvl show dissolve

    # --------------------------------------------------------
    # 8. 混入一个 ADV 角色
    #    你会发现贝尔的话会「顶掉」NVL 窗口单独显示一句，
    #    这就是 ADV 与 NVL 最直观的区别。
    # --------------------------------------------------------
    b "（插一句题外话：我这种是 ADV 角色，一次只说一句。）"

    nvl clear
    narrator "（题外话说完，又回到 NVL 的页面里。）"

    narrator "（本示例到此结束，感谢阅读。）"
    return
