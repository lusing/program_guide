# =============================================================================
# 第 4 章　图像与舞台
# -----------------------------------------------------------------------------
# 本章只看一件事：图像怎么「放上舞台」，以及舞台的两条规则——
#   scene 会「清空」主图层（master）后再摆图；show 是「叠加」到主图层上。
# 为了让示例零素材即可运行，所有图片都用引擎内置的图形拼出来：
#   Solid("#rrggbb") 纯色块、Text("...") 文字、Composite(...) 拼图。
# =============================================================================


# -----------------------------------------------------------------------------
# 1. 角色：和上一章一样，先定义「会说话的人」
# -----------------------------------------------------------------------------
define e = Character("艾琳", who_color="#c8ffc8")


# -----------------------------------------------------------------------------
# 2. 背景：用 Solid 纯色块充当「图片」
# -----------------------------------------------------------------------------
# image <名字> = <显示对象>：这就是把一张图登记进图库。
# 名字里第一个单词是「标签(tag)」，所以两个 bg 共用标签 bg（同一类背景）。
image bg room = Solid("#2b2b3d")
image bg park = Solid("#223322")


# -----------------------------------------------------------------------------
# 3. 角色立绘：用 Composite 把色块和文字拼成一个「人」
# -----------------------------------------------------------------------------
# Composite(总尺寸, (x,y)位置, 图元, (x,y)位置, 图元, ...)
# 这里先铺一层 300x500 的肤色块（用 Solid 的 xysize 指定大小），再叠一行名字。
# 名字里的第一个单词是 tag：这些立绘的 tag 都是 eileen。
image eileen = Composite(
    (300, 500),
    (0, 0), Solid("#d98", xysize=(300, 500)),
    (40, 60), Text("艾琳", size=40),
)


# -----------------------------------------------------------------------------
# 4. 属性（attributes）：同一个 tag 的「不同形态」
# -----------------------------------------------------------------------------
# 「image eileen happy = ...」里，eileen 还是 tag，happy 是「属性」。
# 于是 show eileen happy 和 show eileen sad 是同一个角色换表情：
#   同一个 tag 再次 show，会「替换」原有图像，默认不会有过渡效果。
image eileen happy = Composite(
    (300, 500),
    (0, 0), Solid("#dd9988", xysize=(300, 500)),
    (40, 60), Text("艾琳·开心", size=34),
)
image eileen sad = Composite(
    (300, 500),
    (0, 0), Solid("#8899dd", xysize=(300, 500)),
    (40, 60), Text("艾琳·难过", size=34),
)


# -----------------------------------------------------------------------------
# 5. 位置：引擎内置了 left / center / right / truecenter 等，我们也能自定义
# -----------------------------------------------------------------------------
# transform 用 xalign / yalign 描述对齐方式：0.0 靠左(上)，1.0 靠右(下)。
# 注意：transform 和 image、define 一样，必须写在顶层（第 0 列）。
transform far_left:
    xalign 0.0
    yalign 1.0

transform far_right:
    xalign 1.0
    yalign 1.0


# -----------------------------------------------------------------------------
# 6. 舞台演示
# -----------------------------------------------------------------------------
label start:

    # scene：先清空 master 图层，再把 bg room 摆上去（换场的标准写法）。
    "（旁白）scene 会先清空整个舞台，然后放上背景。"
    scene bg room

    # show：把角色「叠加」到舞台上；at center 让她居中。
    "（旁白）show 是往舞台上叠加图像，at center 表示居中。"
    show eileen at center
    e "我先出场，站在中间。"

    # 同一个角色换个位置：再 show 一次同一个 tag 即可。
    "（旁白）想让她换个位置，再 show 一次、换个 at 就行。"
    show eileen at left
    e "现在我在左边。"

    show eileen at right
    e "又跑到右边啦。"

    # truecenter 是引擎内置的「正中央」（水平垂直都居中）。
    "（旁白）truecenter 是引擎内置的「正中央」。"
    show eileen at truecenter
    e "正中央。"

    # far_left 是我们第 5 节自己定义的变换。
    "（旁白）far_left 是我们自己定义的变换。"
    show eileen at far_left
    e "靠左站好。"

    # 属性演示：加上 happy，tag 依然是 eileen，位置也保持不动。
    # 这里带一个 with dissolve，让表情切换有一点过渡（本章只用到 dissolve）。
    "（旁白）给她加上属性 happy（还是 eileen 这个 tag）。"
    show eileen happy at center with dissolve
    e "换个表情，开心一点。"

    # 同一个 tag 再次 show（且不带 with），直接替换、不会有过渡。
    "（旁白）同 tag 再次 show，会瞬间替换成难过，没有过渡。"
    show eileen sad
    e "又换成难过了。"

    # hide：把角色从舞台上移除（按 tag 移除）。
    "（旁白）hide 把角色从舞台上请下去。"
    hide eileen

    # 再来一次 scene：整个舞台被换掉，之前 show 的东西自然也不见了。
    "（旁白）再 scene 一次，整块舞台连同上面的角色一起换掉。"
    scene bg park

    # 小提示（仅注释）：show 也可以带 zorder（整数，越大越靠前，可正可负），
    # 例如 show eileen at center zorder 5。本章不展开这部分。

    # 结束前的最后一句旁白。
    "（旁白）舞台演示到此结束。"

    # 顶层 return，内容演完后优雅收尾。
    return
