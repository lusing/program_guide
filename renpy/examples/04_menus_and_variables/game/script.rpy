# =============================================================================
# 第 6 章　菜单、变量与分支
# -----------------------------------------------------------------------------
# 本章教三件事：
#   1) 用 menu 让玩家做选择；
#   2) 用变量（default）记住选择的结果，并用 [变量] 把结果写进台词；
#   3) 用 if / elif / else 根据变量决定故事的走向与结局。
# =============================================================================


# -----------------------------------------------------------------------------
# 1. 常量与变量：define 和 default 的区别
# -----------------------------------------------------------------------------
# define  = 编译期常量，编译后就固定，不会随存档变化（适合标题、角色等）。
# default = 运行期变量，值会被写进存档，读档后仍是上次的值（适合剧情数值）。
define GAME_TITLE = "信任的夜晚"    # 常量：标题永远不变
default trust = 0                   # 变量：艾琳对你的信任值
default met_count = 0               # 变量：见面的次数
default menuset = set()             # 变量：记录菜单里已经用过的选项


# -----------------------------------------------------------------------------
# 2. 角色
# -----------------------------------------------------------------------------
define e = Character("艾琳", who_color="#c8ffc8")


# -----------------------------------------------------------------------------
# 3. 菜单与变量
# -----------------------------------------------------------------------------
label start:

    "（旁白）《[GAME_TITLE]》开始了。"

    $ met_count += 1
    "（旁白）这是第 [met_count] 次见到艾琳。"

    # 一个小循环让菜单出现两次——只有这样，才看得到 set 子句「删除已用选项」的效果。
    $ turn = 0
    while turn < 2:
        $ turn += 1

        menu:

            # 标题行（caption）：显示在所有选项的上方。
            "（第 [turn] 轮）今晚做什么？"

            # set 子句：把选过的选项的标题记进 menuset，之后再遇到同名选项就不再显示。
            set menuset

            "散步。":
                $ trust += 1
                e "散步真好呀。"

            "聊天。":
                $ trust += 1
                e "和你聊天很舒服。"

            "喝茶。":
                e "安静地喝杯茶吧。"

            # 条件选项：只有当 trust >= 1 时才出现。
            "追问" if trust >= 1:
                $ trust += 1
                e "你问得真认真。"

    # 把变量插值进台词：注意 [trust] 会被替换成当前数值。
    "（旁白）这一晚结束，你现在的信任值是 [trust]。"

    # 小提示（仅注释）：Ren'Py 不支持「菜单选项 = 值」这种写法，
    # 编译时会报 expected ':' 错误。给变量赋值请写在选项的代码块里，用 $ 变量 = 值。


    # -------------------------------------------------------------------------
    # 4. if / elif / else：根据累积的变量决定结局
    # -------------------------------------------------------------------------
    if trust >= 2:
        $ met_count += 1
        "（旁白）信任值很高（[trust]）。她主动约你：明晚再来，那会是你第 [met_count] 次见她。"
    elif trust >= 1:
        "（旁白）信任值一般（[trust]），你们礼貌地道别。"
    else:
        "（旁白）信任值偏低（[trust]），气氛有点冷清。"

    "（旁白）《[GAME_TITLE]》今夜到此结束。"

    # 顶层 return，内容演完后优雅收尾。
    return
