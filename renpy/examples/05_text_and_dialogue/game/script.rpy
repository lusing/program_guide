# ============================================================
# 示例 05 · 对话进阶与文本            （配套第 7 章）
#
# 本示例演示：
#   - Character 的 what_prefix / what_suffix 前后缀
#   - what_color / what_italic / what_outlines / who_outlines 样式参数
#   - 常用文本标签、暂停标签、extend 续接、花括号与百分号转义
#
# 说明：本示例只使用引擎内建的可视化元素（Solid / Text），
#       不依赖任何图片或音频资源，因此可以直接编译运行。
# ============================================================


# ------------------------------------------------------------
# 1. 带前后缀的角色
#    what_prefix / what_suffix 会在每句台词前后自动加上内容；
#    what_color / what_italic / what_outlines 控制「台词」的样式；
#    who_outlines 控制「角色名」的样式。
#    （这些参数名都以 what_ / who_ 为前缀，后接文本样式属性。）
# ------------------------------------------------------------
define scholar = Character(
    "学者",
    what_prefix="「",
    what_suffix="」",
    what_color="#dfe6ff",
    what_italic=True,
    what_outlines=[ (1, "#000000", 0, 0) ],
    who_outlines=[ (1, "#000000", 0, 0) ],
)

# ------------------------------------------------------------
# 2. 只改一部分样式的角色，用来和上面的「学者」做对比
# ------------------------------------------------------------
define whisper = Character("低语者", what_color="#88ddff", what_italic=True)
define hero = Character("勇者", who_outlines=[ (2, "#ff8800", 0, 0) ])

# ------------------------------------------------------------
# 3. 内建可视化：纯色背景 + 文本显示对象
#    Solid("#rrggbb") 画纯色块，Text(...) 是文本显示对象。
# ------------------------------------------------------------
image bg_panel = Solid("#0f1420")
image title_text = Text("对话进阶与文本", size=46, color="#9fd0ff")
image chapter_tag = Text("第 7 章 示例", size=22, color="#607080")


label start:

    # 3.1 先用内建元素摆出标题画面
    scene bg_panel
    show title_text at truecenter
    show chapter_tag at topleft
    with dissolve

    narrator "本示例演示 Ren'Py 的对话与文本系统。"

    hide title_text
    hide chapter_tag
    with dissolve

    # --------------------------------------------------------
    # 4. 角色样式对比
    # --------------------------------------------------------
    "这一句来自默认的无名叙述者，没有任何额外样式。"
    scholar "我是带前后缀的角色：颜色、斜体、描边都由 Character 参数决定。"
    whisper "我只有颜色和斜体，没有前后缀。"
    hero "我的名字带一圈橙色描边。"

    # --------------------------------------------------------
    # 5. 基础文本标签
    #    {b} 加粗、{i} 斜体、{u} 下划线、{s} 删除线、
    #    {color=#rrggbb} 染色、{size=+n} 调整字号。
    #    这些标签都需要用 {/xxx} 正确闭合（引擎也会自动闭合）。
    # --------------------------------------------------------
    "普通、{b}加粗{/b}、{i}斜体{/i}、{u}下划线{/u}、{s}删除线{/s}。"
    "颜色：{color=#ff4444}红{/color} {color=#44ff44}绿{/color} {color=#4444ff}蓝{/color}。"
    "字号：{size=+10}变大{/size}，{size=-6}变小{/size}，{size=28}固定 28 像素{/size}。"

    # --------------------------------------------------------
    # 6. 暂停与速度标签
    #    {w} 等待点击、{w=0.5} 等待指定秒数、
    #    {p} 段落暂停并换行、{cps=20} 指定每秒显示的字数。
    # --------------------------------------------------------
    "这一行会{w}等待你点击后继续。"
    "这一行会{w=0.5}等待半秒后自动继续。"
    "第一段到此结束{p}这是被 {p} 拆开后的第二段。"
    "下面用固定的慢速显示：{cps=20}逐字缓慢浮现的台词{/cps}，之后恢复正常速度。"

    # --------------------------------------------------------
    # 7. {nw} 立即消失 与 {fast} 瞬间显示
    #    {nw} 会让本行显示完即自动跳过；
    #    下一行的 {fast} 让之前的内容瞬间呈现，常用于无缝衔接。
    # --------------------------------------------------------
    "这句台词说完后会立刻消失……{nw}"
    "……于是紧接着显示了这一句。{fast}"

    # --------------------------------------------------------
    # 8. extend：在上一句台词的基础上「续接」
    #    它由上一句的说话者继续，把「上一句 + 新内容」重新显示出来，
    #    因此可以做到一边切换画面、一边补充台词。
    # --------------------------------------------------------
    hero "我一直守在桥边，等一个人。"
    extend " 直到今天，我才明白自己等的是谁。"

    # --------------------------------------------------------
    # 9. 转义：花括号与百分号
    #    - 左花括号会被当作文本标签的开头，要显示它必须写成 {{
    #    - 右花括号在标签之外并不特殊，直接写 } 即可显示一个 }
    #      （写成 }} 会显示成两个右花括号，并非转义）
    #    - 百分号写成 %% 才会显示成一个 %
    #    关于插值转换标志（写在 [变量!标志] 里）：
    #      !u 转全大写，!l 转全小写，!c 首字母大写，
    #      !t 翻译，!i 递归插值，!q 转义其中的文本标签。
    # --------------------------------------------------------
    "要显示左花括号，写作 {{ ；右花括号直接写 } 即可；百分号写成 %%。"

    "本示例到此结束，感谢阅读。"
    return
