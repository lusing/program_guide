# =============================================================================
# 第 3 章　第一个游戏：对话与角色
# -----------------------------------------------------------------------------
# 运行方式：renpy.sh <本项目目录>（或用 Ren'Py 启动器把它打开）
# 本项目只有这一份 script.rpy，没有图片、没有音乐，只练「对话」和「角色」。
# 学会本文件，你就已经能写一个能跑的视觉小说了。
# =============================================================================


# -----------------------------------------------------------------------------
# 1. 角色：用 Character 定义一个「会说话的人」
# -----------------------------------------------------------------------------
# define 在「编译期」求值，得到的是一个常量：角色这种固定不变的东西就写在这里。
# Character("艾琳", who_color="#c8ffc8") 里的 who_color 是「说话人名字」的颜色。
define e = Character("艾琳", who_color="#c8ffc8")

# 再定义一个配色不同的角色：who_color 换名字颜色，what_color 换「台词文字」的颜色。
define l = Character("莉娜", who_color="#ffc0cb", what_color="#ffe6f0")

# 注意：旁白（没有名字的叙述）不需要定义，直接写一行字符串就行。


# -----------------------------------------------------------------------------
# 2. 变量：用 default 定义一个「会进存档」的值
# -----------------------------------------------------------------------------
# default 定义的是变量，它的值会被写进存档：读档以后仍然是上次的值。
# 和 define 的关键区别：
#   - define  → 常量，编译期就定死，不会随存档变化（适合角色、配置）。
#   - default → 变量，运行中可以改，并且随存档持久化（适合剧情数值）。
default player_name = "旅人"


# -----------------------------------------------------------------------------
# 3. 缩进规则（新手最容易踩的坑）
# -----------------------------------------------------------------------------
# Ren'Py 用「缩进」表示从属关系：冒号「:」说明「下面缩进的内容属于它」。
# label 下面的语句必须缩进；同一层级要对齐，本项目统一用 4 个空格。
# 切记：不要在同一次缩进里混用空格和 Tab，否则会报错。


# -----------------------------------------------------------------------------
# 4. 脚本主体：游戏从 start 这个标签开始执行
# -----------------------------------------------------------------------------
label start:

    # 一行字符串 = 旁白（引擎内置的旁白角色）。
    "（旁白）故事从一个安静的傍晚开始。"

    # 角色 e 说话：写法是「角色名 空格 台词」。
    e "你好，我是艾琳。"

    e "对了，你叫什么名字？"

    # 方括号 [player_name] 是「插值」：会把变量的值填进台词里。
    "（旁白）此刻，你的名字是 [player_name]。"

    # 用 $ 执行一行 Python：这里把变量重新赋值，后面的台词立刻就是新值。
    $ player_name = "小岚"

    e "原来你叫 [player_name]，我记住了。"

    # 第二个角色登场，注意她的名字和台词颜色都和艾琳不同。
    l "我是莉娜。这名字听起来很温柔呢。"

    # [player_name!u] 里的 !u 是「转成大写」的转换标记（!t 翻译、!c 首字母大写等）。
    e "那么，欢迎你，[player_name!u]。"

    # 结束前的最后一句旁白。
    "（旁白）序章到这里就结束了。下次再见。"

    # 顶层的 return：内容演完后优雅收尾，不会因为没有后续内容而报错。
    return
