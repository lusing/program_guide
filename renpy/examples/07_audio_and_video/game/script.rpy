# ============================================================
# 示例 07 · 音频与视频                    （配套第 9 章）
#
# Ren'Py 把声音分到若干「频道」上，常用的内建频道有：
#   music —— 背景音乐（默认循环）
#   sound —— 音效（默认单次播放）
#   audio —— 可同时播放多路音效的频道
#   voice —— 语音
#
# 本示例没有任何音频文件，而是全部使用静音占位：
#   "<silence 秒数>"  表示一段指定时长的静音。
# 这样既能演示各种语句的写法，又不需要任何素材。
# ============================================================


# ------------------------------------------------------------
# 1. 内建可视化：纯色背景 + 状态文本
# ------------------------------------------------------------
image bg_audio = Solid("#0a1218")
image tag_audio = Text("音频与视频", size=30, color="#7fd8ff")


label start:

    scene bg_audio
    show tag_audio at topleft
    with fade

    # --------------------------------------------------------
    # 2. play music —— 播放背景音乐
    #    fadein 让它淡入；这里播放一段 2 秒的静音。
    # --------------------------------------------------------
    play music "<silence 2.0>" fadein 0.5
    "背景音乐开始播放（实际上是一段静音）。"

    # --------------------------------------------------------
    # 3. play sound —— 播放一次音效
    #    音效默认只播一遍，不循环。
    # --------------------------------------------------------
    play sound "<silence 0.3>"
    "刚才触发了一次 0.3 秒的音效。"

    # --------------------------------------------------------
    # 4. play audio —— 在 audio 频道上可以同时叠加多路声音
    #    下面的两条 play audio 会同时播放，互不打断。
    # --------------------------------------------------------
    play audio "<silence 0.5>"
    play audio "<silence 0.8>"
    "audio 频道上现在有两段声音在同时播放。"

    # --------------------------------------------------------
    # 5. queue music —— 把音频「排队」
    #    queue 的内容会在当前播放结束后自动接上。
    # --------------------------------------------------------
    queue music "<silence 1.0>"
    "已经排了一段 1 秒的静音在音乐之后。"

    # --------------------------------------------------------
    # 6. volume 音量子句
    #    注意：音量是「语句的子句」，写在文件名的外面，
    #    形如  play sound "xxx.wav" volume 0.5，
    #    而不是写进文件名里面。取值范围 0.0 ~ 1.0。
    # --------------------------------------------------------
    play sound "<silence 0.4>" volume 0.5
    "这次音效是以一半的音量播放的。"
    queue sound "<silence 0.4>" volume 0.25
    "又排了一段四分之一音量的音效。"

    # --------------------------------------------------------
    # 7. 用 Python 函数控制音量与查询状态
    #    renpy.music.set_volume(音量, delay=秒, channel=频道)
    #    renpy.music.is_playing(频道)  返回是否正在播放
    #    renpy.music.get_playing(频道) 返回正在播放的文件名
    # --------------------------------------------------------
    $ renpy.music.set_volume(0.4, delay=0.5, channel="music")
    "已经把 music 频道音量渐变到 0.4（耗时 0.5 秒）。"

    $ music_on = renpy.music.is_playing("music")
    $ music_file = renpy.music.get_playing("music") or "（空闲）"
    "music 频道是否在播放：[music_on]；当前文件是：[music_file]。"

    # --------------------------------------------------------
    # 8. stop music —— 停止播放，可带淡出
    # --------------------------------------------------------
    stop music fadeout 1.0
    "背景音乐在 1 秒内淡出并停止。"

    # --------------------------------------------------------
    # 9. 视频（本示例不播放，仅作说明）
    #    引擎支持两种播放视频的方式：
    #      - 用 movie 频道：  play movie "video.webm"
    #      - 全屏播放并等待结束：renpy.movie_cutscene("video.webm")
    #    movie_cutscene 的参数为
    #      renpy.movie_cutscene(filename, delay=None, loops=0, stop_music=True)
    #    由于本示例没有视频素材，这里只做说明，不实际调用。
    # --------------------------------------------------------

    # --------------------------------------------------------
    # 10. 收尾
    # --------------------------------------------------------
    "本示例到此结束，感谢阅读。"
    return
