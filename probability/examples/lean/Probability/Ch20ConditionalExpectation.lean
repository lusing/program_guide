import Mathlib.Tactic

/-!
# 第 20 章 条件期望与条件方差（Lean）

有限联合表上的精确账：条件期望是"条件的函数"，塔性质、全方差、
拿出已知量、勾股分解全部归结为有理数算术。

* 联合表（行 x ∈ {0,1,2}，列 y ∈ {0,1,3}，分母 24），
  `E[Y|X=0]=1`、`E[Y|X=1]=13/8`、`E[Y|X=2]=7/5`，
  `P(X)=(6/24, 8/24, 10/24)`；
* 塔性质 `E[E[Y|X]] = E[Y] = 11/8`；
* 全方差 `Var Y = 95/64 = 457/320 + 9/160`；
* 一般代数：全方差的二次恒等式、勾股分解、两点分布条件方差。
-/

/-! ## 具体联合表 -/

/-- 条件均值：分子 0·2+1·3+3·1=6，除以边际 6：E[Y|X=0] = 1。 -/
example : ((0 : ℚ) * 2 + 1 * 3 + 3 * 1) / 6 = 1 := by norm_num

/-- E[Y|X=1] = (0·1+1·4+3·3)/8 = 13/8。 -/
example : ((0 : ℚ) * 1 + 1 * 4 + 3 * 3) / 8 = 13 / 8 := by norm_num

/-- E[Y|X=2] = (0·4+1·2+3·4)/10 = 7/5。 -/
example : ((0 : ℚ) * 4 + 1 * 2 + 3 * 4) / 10 = 7 / 5 := by norm_num

/-- **塔性质（全期望）**：Σ_x P(X=x)·E[Y|X=x] = E[Y] = 11/8。 -/
example : (6 / 24 : ℚ) * 1 + (8 / 24) * (13 / 8) + (10 / 24) * (7 / 5) = 11 / 8 := by
  norm_num

/-- 同一个 E[Y]，直接按联合表求：Σ y·p(x,y)。 -/
example : (1 : ℚ) * (3 + 4 + 2) / 24 + 3 * (1 + 3 + 4) / 24 = 11 / 8 := by norm_num

/-- 条件二阶矩 E[Y²|X=x]：(3+9)/6=2、(4+27)/8=31/8、(2+36)/10=19/5。 -/
example : ((1 : ℚ) * 3 + 9 * 1) / 6 = 2 ∧ (1 * 4 + 9 * 3 : ℚ) / 8 = 31 / 8
    ∧ (1 * 2 + 9 * 4 : ℚ) / 10 = 19 / 5 := by norm_num

/-- 条件方差 Var(Y|X=x) = 二阶矩 − 均值²：1、79/64、46/25。 -/
example : (2 : ℚ) - 1 ^ 2 = 1 ∧ (31 / 8 : ℚ) - (13 / 8) ^ 2 = 79 / 64
    ∧ (19 / 5 : ℚ) - (7 / 5) ^ 2 = 46 / 25 := by norm_num

/-- **E[Var(Y|X)]** = 457/320。 -/
example : (6 / 24 : ℚ) * 1 + (8 / 24) * (79 / 64) + (10 / 24) * (46 / 25) = 457 / 320 := by
  norm_num

/-- **Var(E[Y|X])** = Σ P·m² − (E Y)² = 9/160。 -/
example : (6 / 24 : ℚ) * 1 ^ 2 + (8 / 24) * (13 / 8) ^ 2 + (10 / 24) * (7 / 5) ^ 2
    - (11 / 8) ^ 2 = 9 / 160 := by norm_num

/-- **全方差**：Var Y = 95/64 = E[Var(Y|X)] + Var(E[Y|X])。 -/
example : (457 / 320 : ℚ) + 9 / 160 = 95 / 64 := by norm_num

/-- Var Y 的直接计算：E[Y²] = (1·9 + 9·8)/24 = 81/24，减去 (11/8)²。 -/
example : (1 * (3 + 4 + 2) + 9 * (1 + 3 + 4) : ℚ) / 24 - (11 / 8) ^ 2 = 95 / 64 := by
  norm_num

/-- **拿出已知量**：E[X·Y] = Σ P(x)·x·E[Y|X=x] = 0 + (8/24)(13/8) + 2(10/24)(7/5)。 -/
example : (0 : ℚ) + (8 / 24) * 1 * (13 / 8) + (10 / 24) * 2 * (7 / 5) = 41 / 24 := by
  norm_num

/-- 残差与 X 正交：Σ_x P(x)·x·(m(x) − m(x)) = 0 的具体算术版：
Σ_{(x,y)} p(x,y)·x·(y − m(x)) = 0（逐行分子为 0）。 -/
example : (1 : ℚ) * (0 - 13 / 8) * 1 + 4 * (1 - 13 / 8) + 3 * (3 - 13 / 8) = 0 := by
  norm_num

/-! ## 一般代数恒等式 -/

/-- **勾股分解**（最佳预测）：对条件均值 m 与任意预测值 g，
`E[(Y−g)²|x] = Var + (m−g)²`，其形式为 `(y−g)² = (y−m)² + 2(y−m)(m−g) + (m−g)²`，
交叉项在条件期望下为 0。这里验证代数展开。 -/
example (y m g : ℚ) : (y - g) ^ 2 = (y - m) ^ 2 + 2 * (y - m) * (m - g) + (m - g) ^ 2 := by
  ring

/-- **两点条件分布**：Y 取 a，b 概率 p, 1−p 时，均值 m=pa+(1−p)b，
方差 = p(1−p)(a−b)²。 -/
example (a b p : ℚ) :
    p * a ^ 2 + (1 - p) * b ^ 2 - (p * a + (1 - p) * b) ^ 2 = p * (1 - p) * (a - b) ^ 2 := by
  ring

/-- **全方差的代数骨架**：两层混合 Var = Σ w_i (v_i + m_i²) − (Σ w_i m_i)²
等于 Σ w_i v_i + (Σ w_i m_i² − (Σ w_i m_i)²)。两个分组（权重 w, 1−w）。 -/
example (w m₁ m₂ v₁ v₂ : ℚ) :
    (w * (v₁ + m₁ ^ 2) + (1 - w) * (v₂ + m₂ ^ 2)) - (w * m₁ + (1 - w) * m₂) ^ 2
      = (w * v₁ + (1 - w) * v₂)
        + (w * m₁ ^ 2 + (1 - w) * m₂ ^ 2 - (w * m₁ + (1 - w) * m₂) ^ 2) := by
  ring

/-- 两组均值之差给出组间方差：w m₁² + (1−w) m₂² − (w m₁ + (1−w) m₂)² = w(1−w)(m₁−m₂)²。 -/
example (w m₁ m₂ : ℚ) :
    w * m₁ ^ 2 + (1 - w) * m₂ ^ 2 - (w * m₁ + (1 - w) * m₂) ^ 2 = w * (1 - w) * (m₁ - m₂) ^ 2 := by
  ring

/-- **随机个数求和（Wald 型全方差）**：N 的均值 μ_N、方差 σ_N²，
每项均值 m、方差 v，则 Var(S) = μ_N v + σ_N² m²——代数形式。 -/
example (μN σN m v : ℚ) :
    μN * v + σN * m ^ 2 = μN * v + m ^ 2 * σN := by ring

/-- Poisson–二项稀疏化：Var Y = λp(1−p) + p²λ = λp。 -/
example (lam p : ℚ) : lam * p * (1 - p) + p ^ 2 * lam = lam * p := by ring

/-! ## 硬币序列：随信息增长条件方差下降 -/

/-- n 次公平硬币，已见 k 次后，Var(S_n|F_k) = (n−k)/4；n=10 时依次为 10/4,…,0。 -/
example : (fun k : ℕ => ((10 - k : ℕ) : ℚ) / 4) 3 = 7 / 4 := by norm_num

/-- 鞅性的算术：M_k = S_k + (n−k)/2，下一次取 0 或 1 各 1/2，均值回到 M_k。 -/
example (s : ℚ) (r : ℚ) :
    (1 / 2 : ℚ) * ((s + 0) + (r - 1) / 2) + (1 / 2) * ((s + 1) + (r - 1) / 2) = s + r / 2 := by
  ring

/-- E[S_n | S_n]-对称性例：E[X₁|S₄=s]=s/4，s=2 时 = 1/2：
路径中 S=2 有 6 条，第一位为 1 的有 3 条。 -/
example : (3 : ℚ) / 6 = 1 / 2 := by norm_num
