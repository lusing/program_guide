import Mathlib.Algebra.BigOperators.Group.Finset.Basic
import Mathlib.Algebra.Field.GeomSum
import Mathlib.Tactic

/-!
# 第 01 章 三个招牌问题（Lean）

Miller ch1 的机器侧第一站：① 生日问题的**精确判决**——22 人
不过半、23 人过半（两个 Nat 大数不等式由 kernel 直接裁决）；
② 几何级数的有限和与投篮账的精确分数（ℚ 上一行）。

本科向说明：本文件是"可以运行的证明卡片"——正文 01.5 已把
两笔账讲清，这里的 Lean 代码是同一笔账的零差错重演。
-/

open Finset

/-! ## 生日问题：22 与 23 的机器判决 -/

/-- k 人生日全不同的分子：365 · 364 · … · (365−k+1)。
即 ∏_{j<k} (365−j)。 -/
def falling365 (k : ℕ) : ℕ := ∏ j ∈ range k, (365 - j)

/-- 生日算术的**三点判决**：
① 1 人必不撞（trivial 但给机器对齐）；
② 22 人：2 × 分子 < 365²²（全不同概率 < 1/2，撞车 < 一半）；
③ 23 人：2 × 分子 > 365²³（全不同概率 < 1/2，撞车 **过半**）。
Nat kernel 直接裁决大数不等式——正文 01.1 的数字在这里
"永不口误"。 -/
example : falling365 1 = 365 := by decide

/-- **主判决**：23 人全不同的概率 < 1/2 ⟺ 2·falling365 23 <
365²³——生日悖论过半线在 23 的机器证明。 -/
example : falling365 23 * 2 < 365 ^ 23 := by decide

/-- 22 人未过半：全不同概率 > 1/2 ⟺ 2·falling365 22 > 365²²
——与上一条合成夹逼：23 是撞车过半的最小人数。 -/
example : falling365 22 * 2 > 365 ^ 22 := by decide

/-! ## 几何级数与投篮账 -/

#check @geom_sum_eq

/-- 有限几何和的实弹：1 + 3/10 + (3/10)² + (3/10)³ 的精确值
（decide 的有限精确算术——ℚ 上无舍入）。 -/
example : ∑ i ∈ range 4, ((3 : ℚ) / 10) ^ i = 1 + 3 / 10 + 9 / 100 + 27 / 1000 := by
  norm_num [Finset.sum_range_succ]

/-- **投篮账的机器版**：A 胜率 = p/(1−r)，r = (1−p)(1−q)。
p = 1/2、q = 2/5 时 r = (1/2)·(3/5) = 3/10，胜率 = (1/2)/(7/10) = 5/7。 -/
example : (1 : ℚ) / 2 / (1 - 3 / 10) = 5 / 7 := by norm_num

