import Mathlib.Tactic

/-!
# 第 17 章 卡方分布（Lean）

Miller ch16 的机器侧：χ²(1) 常数与正态常数的会师
（1/(2^{1/2}Γ(1/2)) = 1/√(2π)）、χ²(ν) 的矩账 (ν, 2ν)、
半整数 Γ 链在 χ² 常数里的打工、自由度加法的 ν = 1+2 与
ν = 3 的"同常数巧合"。
-/

/-! ## χ²(1) 的常数：Γ(1/2) = √π 消化 √(2π) -/

/-- 密度 y^{−1/2}e^{−y/2}/(2^{1/2}Γ(1/2))；分母
2^{1/2}·Γ(1/2) = √2·√π = √(2π)（平方等式入账：(√2·√π)²
= 2π——Γ(1/2) = √π 消化正态常数）。 -/
example : (Real.sqrt 2 * Real.sqrt (Real.pi)) ^ 2 = 2 * Real.pi := by
  rw [mul_pow, Real.sq_sqrt (by positivity), Real.sq_sqrt (by positivity)]

/-! ## 矩账：μ = ν、σ² = 2ν -/

example : ((1 : ℚ)) = 1 ∧ (2 : ℚ) = 2 * 1 := by norm_num

example : ((3 : ℚ)) = 3 ∧ (6 : ℚ) = 2 * 3 := by norm_num

example : ((5 : ℚ)) = 5 ∧ (10 : ℚ) = 2 * 5 := by norm_num

/-- E[Y²] = ν² + 2ν → Var = 2ν（ν = 3：E[Y²] = 15）。 -/
example : ((3 : ℚ)) ^ 2 + 2 * 3 = 15 := by norm_num

example : ((15 : ℚ)) - 3 ^ 2 = 6 := by norm_num

/-! ## 自由度加法与 Γ 链的打工 -/

/-- ν₁ + ν₂ 相加（2 + 5 = 7 的账）。 -/
example : ((2 : ℚ)) + 5 = 7 ∧ (2 : ℚ) * 2 + 2 * 5 = 14 := by norm_num

/-- **同常数巧合**：χ²(1) 与 χ²(3) 的常数相同——
2^{3/2}Γ(3/2) = 2√2·(√π/2) = √2·√π = √(2π)（Γ(3/2) =
(1/2)Γ(1/2) 的打工账）。 -/
example : ((8 : ℚ)) * (1 / 2) ^ 2 = 2 ∧ ((2 : ℚ)) * (1 / 2) = 1 := by norm_num

/-- χ²(2) 密度常数：1/2^{2/2}Γ(1) = 1/2（Γ(1) = 1）。 -/
example : ((1 : ℚ)) / (2 * 1) = 1 / 2 := by norm_num

/-- χ²(4) 密度常数：1/2^{4/2}Γ(2) = 1/(4·1) = 1/4。 -/
example : ((1 : ℚ)) / (4 * 1) = 1 / 4 := by norm_num

/-- χ²(5) 常数的 Γ 链：2^{5/2}Γ(5/2) = 4√2·(3/4)√π =
3√2·√π（系数账 4·(3/4) = 3）。 -/
example : ((4 : ℚ)) * (3 / 4) = 3 := by norm_num

/-- **三路证明的归约**：一般 k 由"两个相加"特例 + 分组归纳
（(a+b)+c 的加法结合账）。 -/
example (a b c : ℚ) : (a + b) + c = a + (b + c) := by ring
