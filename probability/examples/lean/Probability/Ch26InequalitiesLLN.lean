import Mathlib.Tactic

/-!
# 第 18 章 不等式与大数定律（Lean）

Miller ch17 的机器侧：两点反例的精确账（零均值族把
P(X ≥ 2) 推到任意接近 1）、Chebyshev 的 k 换算与 σ/σ²
事故账、Var(X̄_n) = σ²/n 的两行账、WLLN 界 σ²/(nε²) 的
递减判决、Boole 不等式的三点数值账。
-/

/-! ## 两点反例：只知均值无 非平凡界 -/

/-- **配平账**：P(X=2) = p、P(X=−b) = 1−p、b = 2p/(1−p)
时均值恰为零（p = 9/10 → b = 18）。 -/
example : ((2 : ℚ)) * (9 / 10) + (-(18 : ℚ)) * (1 - 9 / 10) = 0 := by norm_num

/-- 此时 P(X ≥ 2) = 9/10——只知均值，尾概率可任意接近 1。 -/
example : ((9 : ℚ)) / 10 = 0.9 := by norm_num

/-- **Markov 非负性反例**：X = ±1 等概率，E[X] = 0——若
Markov 结论成立则 P(X ≥ 1/2) ≤ 0，荒谬。 -/
example : ((1 : ℚ)) * (1 / 2) + (-(1 : ℚ)) * (1 / 2) = 0 := by norm_num

example : ((1 : ℚ)) / 2 + 1 / 2 = 1 := by norm_num   -- P(X=±1) = 1

/-! ## Chebyshev 的换算账 -/

/-- **k 换算**：P(X ≥ ℓμ) 的距离 (ℓ−1)μ 折算 k = (ℓ−1)μ/σ；
ℓ = 2、μ = 5、σ = 5 → k = 1。 -/
example : ((2 - 1 : ℚ)) * 5 / 5 = 1 := by norm_num

/-- **σ²/σ 事故**：Unif(0,1) 的 σ² = 1/12；误当 σ 用则
k = 0.45·12 = 27/5（错误），正确 k = 0.45·√12 ≈ 1.56
（平方形态：k² = 0.45²·12 = 2.43）。 -/
example : ((45 : ℚ)) / 100 * 12 = 27 / 5 := by norm_num

example : ((45 : ℚ)) ^ 2 / 10000 * 12 = 243 / 100 := by norm_num

/-- 错误界 1/(27/5)² = 25/729 ≈ 0.034 **低于真值 0.05**
——矛盾信号。 -/
example : ((1 : ℚ)) / (27 / 5) ^ 2 = 25 / 729 := by norm_num

example : ((25 : ℚ)) / 729 < 5 / 100 := by norm_num

/-! ## Var(X̄_n) = σ²/n：WLLN 的两行账 -/

/-- n = 12、σ² = 3 → Var(X̄) = 1/4。 -/
example : ((3 : ℚ)) / 12 = 1 / 4 := by norm_num

/-- **WLLN 界**：P(|X̄ − μ| ≥ ε) ≤ σ²/(nε²)；σ² = 1、ε = 1/10、
n = 10⁵ → 界 = 10⁻³。 -/
example : ((1 : ℚ)) / (10 ^ 5 * (1 / 10) ^ 2) = 1 / 1000 := by norm_num

/-- n = 10⁶ → 10⁻⁴（递减判决）。 -/
example : ((1 : ℚ)) / (10 ^ 6 * (1 / 10) ^ 2) = 1 / 10000 := by norm_num

example : ((1 : ℚ)) / 10000 < 1 / 1000 := by norm_num

/-! ## Boole 不等式的三点数值账 -/

/-- P(A) = 0.3、P(B) = 0.4、P(A∩B) = 0.1 时
P(A∪B) = 0.6 ≤ 0.3 + 0.4 = 0.7（容斥二事件 + Boole）。 -/
example : ((3 : ℚ)) / 10 + (4 / 10) - (1 / 10) = 6 / 10 := by norm_num

example : ((6 : ℚ)) / 10 ≤ 3 / 10 + 4 / 10 := by norm_num

/-- Bonferroni 下界：S₁ − S₂ = 0.6 ≤ P(A∪B)。 -/
example : ((3 : ℚ)) / 10 + (4 / 10) - 2 * (1 / 10) ≤ 6 / 10 := by norm_num

/-! ## 1/√n 律 -/

/-- 样本均值的标准差 σ/√n：σ² = 1、n = 10⁴ → 标准差 1/100
（平方形态入账：σ²/n = (σ/√n)²）。 -/
example : ((1 : ℚ)) ^ 2 / 10 ^ 4 = (1 / 100) ^ 2 := by norm_num

/-- **精度翻倍要四倍样本**：方差账 σ²/(4n) = (σ²/n)/4。 -/
example (v n : ℚ) : v / (4 * n) = (v / n) / 4 := by ring
