import Mathlib.Tactic

/-!
# 第 10 章 期望工具（Lean）

Miller ch9 的机器侧：矩账（三硬币 / 骰子 / 两骰和）、
方差捷径 Var = E[X²] − E[X]² 的逐笔对拍、线性性的
Finset 形态锚点、投资组合 w = 1/2 的方差减半账、
零协方差不独立的对称相消——全部 ℚ 精确判决。
-/

/-! ## 锚点正名：线性性的 Finset 形态 -/

#check @Finset.sum_add_distrib   -- E[X+Y] = E[X]+E[Y] 的和形态
#check @Finset.mul_sum           -- E[aX] = a·E[X] 的系数外提

/-! ## 三硬币：矩账 -/

/-- **均值**：E[X] = (0·1 + 1·3 + 2·3 + 3·1)/8 = 3/2。 -/
example : (0 * (1 : ℚ) / 8 + 1 * 3 / 8 + 2 * 3 / 8 + 3 * 1 / 8) = 3 / 2 := by
  norm_num

/-- **二阶矩**：E[X²] = (0 + 3 + 12 + 9)/8 = 3。 -/
example : (0 * (1 : ℚ) + 1 * 3 / 8 + 4 * 3 / 8 + 9 * 1 / 8) = 3 := by norm_num

/-- **方差捷径**：Var = E[X²] − E[X]² = 3 − 9/4 = 3/4。 -/
example : (3 : ℚ) - (3 / 2) ^ 2 = 3 / 4 := by norm_num

/-! ## 骰子：捷径 vs 定义式 -/

/-- **均值**：E[X] = 21/6 = 7/2。 -/
example : ((1 : ℚ) + 2 + 3 + 4 + 5 + 6) / 6 = 7 / 2 := by norm_num

/-- **二阶矩**：E[X²] = 91/6。 -/
example : ((1 : ℚ) + 4 + 9 + 16 + 25 + 36) / 6 = 91 / 6 := by norm_num

/-- **方差**：91/6 − (7/2)² = 35/12（捷径一行收割）。 -/
example : (91 / 6 : ℚ) - (7 / 2) ^ 2 = 35 / 12 := by norm_num

/-- **定义式对拍**：Σ(k − 7/2)²/6 = 35/12（两条路同一
答案——捷径的合法性）。 -/
example : ((-5 / 2 : ℚ) ^ 2 + (-3 / 2) ^ 2 + (-1 / 2) ^ 2
    + (1 / 2) ^ 2 + (3 / 2) ^ 2 + (5 / 2) ^ 2) / 6 = 35 / 12 := by norm_num

/-! ## 两骰之和 R：均值与方差 -/

/-- **均值（对称性免算）**：pmf 关于 7 对称 ⟹ E[R] = 7。
这里给出账面验证：Σ r·w/36 = 7。 -/
example : ((2 : ℚ) * 1 + 3 * 2 + 4 * 3 + 5 * 4 + 6 * 5 + 7 * 6 + 8 * 5
    + 9 * 4 + 10 * 3 + 11 * 2 + 12 * 1) / 36 = 7 := by norm_num

/-- **方差**：Σ(r−7)²·w/36 = 210/36 = 35/6。 -/
example : ((25 : ℚ) * 1 + 16 * 2 + 9 * 3 + 4 * 4 + 1 * 5 + 0 * 6 + 1 * 5
    + 4 * 4 + 9 * 3 + 16 * 2 + 25 * 1) / 36 = 35 / 6 := by norm_num

/-! ## 两班级：均值同、方差天差地别 -/

/-- 甲班 {40,45,50,55,60}：均值 50、方差 50。 -/
example : ((100 : ℚ) + 25 + 0 + 25 + 100) / 5 = 50 := by norm_num

/-- 乙班 {0,25,50,75,100}：均值同为 50…… -/
example : ((0 : ℚ) + 25 + 50 + 75 + 100) / 5 = 50 := by norm_num

/-- ……而方差 1250（25 倍于甲班——均值分辨不出的差异
方差一锤定音）。 -/
example : ((2500 : ℚ) + 625 + 0 + 625 + 2500) / 5 = 1250 := by norm_num

/-! ## 多项式密度：r 阶矩闭式与 E[e^X] -/

/-- **r = 1 闭式核对**：(6/11)·(7+11)/(2·3·4) = 9/22。 -/
example : (6 / 11 : ℚ) * (7 * 1 + 11) / ((1 + 1) * (1 + 2) * (1 + 3))
    = 9 / 22 := by norm_num

/-- **E[e^X] 的结构账**：(6/11)(2(e−1) + 3·1 − 5(e−2))
= 6 − 18e/11（ring 层面合成；e = exp 1）。 -/
example : (6 / 11 : ℝ) * (2 * (Real.exp 1 - 1) + 3 * 1
    - 5 * (Real.exp 1 - 2)) = 6 - 18 * Real.exp 1 / 11 := by ring

/-! ## 投资组合：w = 1/2 的方差减半 -/

/-- **抛物线谷底**：Var(S) = 2(w² + (1−w)²) 在 w = 1/2
取值 1（原方差 2 的一半——对冲的红利）。 -/
example : (((1 : ℚ) / 2) ^ 2 + (1 - 1 / 2) ^ 2) * 2 = 1 := by norm_num

/-- **端点对照**：w = 1（全押一只）时方差 = 2。 -/
example : (((1 : ℚ) ^ 2 + (1 - 1) ^ 2) * 2) = 2 := by norm_num

/-! ## 零协方差 ≠ 独立 -/

/-- X 均匀于 {−2,−1,1,2}、Y = X²：Cov = E[X³]/4 = 0
（对称相消），但 Y 完全由 X 决定——协方差只测线性
关联的最小反例。 -/
example : ((1 : ℚ) / 4) * ((-2) ^ 3 + (-1) ^ 3 + 1 ^ 3 + 2 ^ 3) = 0 := by
  norm_num

/-- 同一 X 的均值也是 0（E[X·Y] − μ_X·μ_Y = 0 − 0 = 0
的另一半）。 -/
example : ((1 : ℚ) / 4) * ((-2) + (-1) + 1 + 2) = 0 := by norm_num
