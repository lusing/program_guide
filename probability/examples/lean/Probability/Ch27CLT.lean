import Mathlib.Tactic

/-!
# 第 27 章 中心极限定理（Lean）

这里验证特征函数证明所用的**标准化代数、二阶系数和极限乘积**。
一般 iid 有限方差 CLT 的测度论证明在正文中给出；本文件不把有限
有理数恒等式冒充 Lévy 连续性定理，也不额外假设矩生成函数存在。
-/

namespace Ch27

/-! ## 标准化与尺度 -/

/-- 标准化再乘回标准差，代数上严格还原中心化变量。 -/
theorem standardize_scale (x μ σ : ℚ) (hσ : σ ≠ 0) :
    (x - μ) / σ * σ = x - μ := by
  field_simp

/-- 样本均值的方差：独立和的方差为 `Nσ²`，除以 `N²` 得 `σ²/N`。 -/
theorem mean_variance (s N : ℚ) (hN : N ≠ 0) :
    s ^ 2 * N / N ^ 2 = s ^ 2 / N := by
  field_simp

/-- 精度翻倍需要四倍样本。 -/
example (v n : ℚ) : v / (4 * n) = (v / n) / 4 := by ring

/-! ## 特征函数的二阶项与极限乘积 -/

/-- 标准化单变量的二阶项：实部从 `1-u²/2` 开始；
代入 `u=t/√N` 后二次系数为 `-t²/(2N)`。 -/
example (t N : ℚ) (hN : N ≠ 0) :
    -(t ^ 2 / N) / 2 = -t ^ 2 / (2 * N) := by
  field_simp

/-- `N=100、w=-1/2` 的精确幂：分母幂与整体幂一致。 -/
example : ((199 : ℚ) / 200) ^ 100 = (199 ^ 100) / (200 ^ 100) := by
  norm_num [div_pow]

/-- 正态特征函数 `exp(-t²/2)` 的二次与四次 Taylor 系数。 -/
example : ((-1 : ℚ) / 2) ^ 2 / 2 = 1 / 8 := by norm_num

/-- 正态偶矩 `1,3,15,105` 与指数级数的双阶乘系数相符。 -/
example : ((3 : ℚ)) * 5 * 7 = 105 := by norm_num

/-! ## Poisson 特例与格点 -/

/-- Poisson 特征函数指数中的主项：`u=t/√λ`，故 `λu²=t²`。 -/
example (t : ℚ) : ((4 : ℚ)) * (t / 2) ^ 2 = t ^ 2 := by
  field_simp
  ring

/-- 连续性修正：`Bin(100,1/2)` 的 `[45,55]` 变为 `[44.5,55.5]`；
以均值 50、标准差 5 标准化后是 `[-1.1,1.1]`。 -/
example : ((55.5 : ℚ) - 50) / 5 = 11 / 10 ∧
    ((44.5 : ℚ) - 50) / 5 = -11 / 10 := by
  norm_num

/-- 对称 ±1 随机游走的支撑格距是 2，不是 1。 -/
example (k : ℤ) : (2 * k + 2) - 2 * k = 2 := by ring

end Ch27
