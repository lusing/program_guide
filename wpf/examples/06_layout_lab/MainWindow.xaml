<Window x:Class="LayoutLab.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="布局实验室" Height="420" Width="640">
    <TabControl Margin="8">

        <!-- ① 共享尺寸：多个 Grid 的列对齐 -->
        <TabItem Header="共享尺寸">
            <StackPanel Grid.IsSharedSizeScope="True" Margin="12">
                <TextBlock Text="两个独立的 Grid，标签列却能对齐——SharedSizeGroup 的功劳"
                           Margin="0,0,0,10" Foreground="#555"/>
                <Grid Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" SharedSizeGroup="label"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="姓名：" FontWeight="Bold"/>
                    <TextBox Grid.Column="1" Text="王小明"/>
                </Grid>
                <Grid Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" SharedSizeGroup="label"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="电子邮箱地址：" FontWeight="Bold"/>
                    <TextBox Grid.Column="1" Text="xiaoming@example.com"/>
                </Grid>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" SharedSizeGroup="label"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="部门：" FontWeight="Bold"/>
                    <TextBox Grid.Column="1" Text="研发中心"/>
                </Grid>
            </StackPanel>
        </TabItem>

        <!-- ② Viewbox：把固定尺寸的界面整体缩放 -->
        <TabItem Header="Viewbox 缩放">
            <DockPanel Margin="12">
                <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                    <TextBlock Text="下面这块面板固定 300×120，拖动窗口大小看它如何整体缩放"
                               Foreground="#555"/>
                    <StackPanel Orientation="Horizontal">
                        <RadioButton x:Name="StretchUniform" Content="Uniform（等比）" IsChecked="True"
                                     Margin="0,0,16,0" Checked="Stretch_Changed"/>
                        <RadioButton x:Name="StretchFill" Content="Fill（拉伸）"
                                     Margin="0,0,16,0" Checked="Stretch_Changed"/>
                        <RadioButton x:Name="StretchNone" Content="None（原样）" Checked="Stretch_Changed"/>
                    </StackPanel>
                </StackPanel>
                <Border BorderBrush="#BBB" BorderThickness="1" Background="#FAFAFA">
                    <Viewbox x:Name="ScaleBox" Stretch="Uniform">
                        <StackPanel Width="300" Height="120" Background="AliceBlue">
                            <TextBlock Text="我是 300×120 的固定面板" FontSize="16"
                                       HorizontalAlignment="Center" Margin="8"/>
                            <Button Content="窗口再小我也完整" Width="160" Height="30"
                                    HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Viewbox>
                </Border>
            </DockPanel>
        </TabItem>

        <!-- ③ ScrollViewer + WrapPanel：内容超出与流式换行 -->
        <TabItem Header="滚动与折行">
            <DockPanel Margin="12">
                <TextBlock DockPanel.Dock="Top" Text="50 个标签放进 WrapPanel，宽度不够自动折行；整体再套 ScrollViewer 保证滚得动"
                           Foreground="#555" Margin="0,0,0,10" TextWrapping="Wrap"/>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <WrapPanel x:Name="ChipPanel"/>
                </ScrollViewer>
            </DockPanel>
        </TabItem>

        <!-- ④ 星号比例与 Auto：窗口拉大时的分配 -->
        <TabItem Header="星号与 Auto">
            <Grid Margin="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="三列宽度 1* : 2* : Auto。拖动窗口宽度：前两列按 1:2 瓜分剩余空间，第三列永远刚好包住内容"
                           Foreground="#555" Margin="0,0,0,10" TextWrapping="Wrap"/>
                <Grid Grid.Row="1" SizeChanged="StarGrid_SizeChanged">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1*" MinWidth="80"/>
                        <ColumnDefinition Width="2*" MinWidth="120"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border x:Name="Col1" Background="#DBEAFE" Margin="0,0,4,0">
                        <TextBlock Text="1*" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <Border x:Name="Col2" Grid.Column="1" Background="#DCFCE7" Margin="0,0,4,0">
                        <TextBlock Text="2*" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <Border x:Name="Col3" Grid.Column="2" Background="#FEF3C7">
                        <TextBlock Text="Auto 自动列" Margin="12,0" VerticalAlignment="Center"/>
                    </Border>
                </Grid>
                <TextBlock Grid.Row="2" x:Name="SizeReport" Foreground="#555" Margin="0,10,0,0"/>
            </Grid>
        </TabItem>
    </TabControl>
</Window>
