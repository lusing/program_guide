<Window x:Class="LayoutDemo.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Layout Demo" Height="420" Width="620">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="布局示例" FontSize="24" FontWeight="Bold" Margin="0,0,0,12"/>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="AliceBlue" Margin="0,0,12,0" Padding="12" BorderBrush="LightGray" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="菜单" FontWeight="Bold" Margin="0,0,0,8"/>
                    <Button Content="首页" Margin="0,0,0,8"/>
                    <Button Content="文档" Margin="0,0,0,8"/>
                    <Button Content="设置"/>
                </StackPanel>
            </Border>

            <DockPanel Grid.Column="1" LastChildFill="True">
                <TextBlock DockPanel.Dock="Top" Text="工作区" FontWeight="Bold" Margin="0,0,0,8"/>
                <TextBox DockPanel.Dock="Bottom" Height="90" Text="这里展示正文内容…" TextWrapping="Wrap" AcceptsReturn="True"/>
                <Border BorderBrush="LightGray" BorderThickness="1" Padding="10">
                    <StackPanel>
                        <TextBlock Text="主内容区域" FontSize="16" Margin="0,0,0,8"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Content="新建" Margin="0,0,8,0"/>
                            <Button Grid.Column="1" Content="保存"/>
                        </Grid>
                    </StackPanel>
                </Border>
            </DockPanel>
        </Grid>

        <StatusBar Grid.Row="2" Margin="0,12,0,0">
            <TextBlock Text="Ready"/>
        </StatusBar>
    </Grid>
</Window>
