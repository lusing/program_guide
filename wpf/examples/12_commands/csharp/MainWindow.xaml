<Window x:Class="CommandDemo.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Command Demo" Height="260" Width="420">
    <Window.CommandBindings>
        <!-- WPF 命令库（教材 9.2.5）：ApplicationCommands.Copy 是现成的 RoutedUICommand -->
        <CommandBinding Command="ApplicationCommands.Copy"
                        Executed="CopyBinding_Executed" CanExecute="CopyBinding_CanExecute"/>
    </Window.CommandBindings>
    <StackPanel Margin="20">
        <TextBlock Text="命令系统示例" FontSize="22" FontWeight="Bold" Margin="0,0,0,12"/>
        <TextBox Text="{Binding TaskName, UpdateSourceTrigger=PropertyChanged}" Width="250" HorizontalAlignment="Left" Margin="0,0,0,12"/>
        <Button Content="执行命令" Command="{Binding AddTaskCommand}" Width="140" Height="36"/>
        <TextBlock Text="{Binding StatusText}" Margin="0,12,0,0" FontSize="16"/>
        <Button Content="命令库: 复制（Ctrl+C 也可）" Command="ApplicationCommands.Copy"
                Width="200" Height="32" Margin="0,16,0,0"/>
    </StackPanel>
</Window>
