<Window x:Class="ValidationDemo.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="表单验证" Height="440" Width="440">
    <Window.Resources>
        <!-- 自定义错误模板：红框 + 叹号，悬停叹号可看完整信息（默认样式只是红框） -->
        <ControlTemplate x:Key="ValidationErrorTemplate">
            <StackPanel Orientation="Horizontal">
                <Border BorderBrush="#EF4444" BorderThickness="1.5" CornerRadius="4">
                    <AdornedElementPlaceholder/>
                </Border>
                <TextBlock Text="!" Foreground="#EF4444" FontWeight="Bold" FontSize="16"
                           Margin="6,0,0,0" VerticalAlignment="Center"
                           ToolTip="{Binding [0].ErrorContent}"/>
            </StackPanel>
        </ControlTemplate>
    </Window.Resources>

    <StackPanel Margin="20">
        <TextBlock Text="逐字输入体会验证时机（UpdateSourceTrigger=PropertyChanged）" Foreground="#555"
                   Margin="0,0,0,14" TextWrapping="Wrap"/>

        <TextBlock Text="用户名（必填 ≥2 字符）"/>
        <TextBox x:Name="UserNameBox" Margin="0,2,0,2"
                 Text="{Binding UserName, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}"
                 Validation.ErrorTemplate="{StaticResource ValidationErrorTemplate}"/>
        <TextBlock Foreground="#EF4444" FontSize="11" Margin="4,0,0,10"
                   Text="{Binding (Validation.Errors)[0].ErrorContent, ElementName=UserNameBox, FallbackValue=''}"/>

        <TextBlock Text="年龄（18–60 的整数）"/>
        <TextBox x:Name="AgeBox" Margin="0,2,0,2"
                 Text="{Binding AgeText, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}"
                 Validation.ErrorTemplate="{StaticResource ValidationErrorTemplate}"/>
        <TextBlock Foreground="#EF4444" FontSize="11" Margin="4,0,0,10"
                   Text="{Binding (Validation.Errors)[0].ErrorContent, ElementName=AgeBox, FallbackValue=''}"/>

        <TextBlock Text="邮箱（可留空；填了须含 @）"/>
        <TextBox x:Name="EmailBox" Margin="0,2,0,2"
                 Text="{Binding Email, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}"
                 Validation.ErrorTemplate="{StaticResource ValidationErrorTemplate}"/>
        <TextBlock Foreground="#EF4444" FontSize="11" Margin="4,0,0,16"
                   Text="{Binding (Validation.Errors)[0].ErrorContent, ElementName=EmailBox, FallbackValue=''}"/>

        <Button Content="提交" Width="120" HorizontalAlignment="Left" Click="Submit_Click"/>
        <TextBlock Text="{Binding Result}" Margin="0,16,0,0" TextWrapping="Wrap" FontWeight="Bold"/>
    </StackPanel>
</Window>
