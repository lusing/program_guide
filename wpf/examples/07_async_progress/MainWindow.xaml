<Window x:Class="AsyncProgressDemo.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Async Progress Demo" Height="220" Width="420">
    <StackPanel Margin="20">
        <TextBlock Text="异步任务与进度" FontSize="22" FontWeight="Bold" Margin="0,0,0,12"/>
        <ProgressBar Height="20" Minimum="0" Maximum="100" Value="{Binding Progress}" Margin="0,0,0,12"/>
        <TextBlock Text="{Binding StatusText}" FontSize="16" Margin="0,0,0,12"/>
        <Button Content="启动任务" Command="{Binding StartCommand}" Width="140" Height="36"/>
    </StackPanel>
</Window>
