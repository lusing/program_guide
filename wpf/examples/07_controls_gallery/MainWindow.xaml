<Window x:Class="ControlsGallery.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="控件画廊" Height="520" Width="560">
    <DockPanel Margin="12">
        <TextBlock DockPanel.Dock="Top" Text="每个控件的事件都汇到底部状态栏——试着操作任意一个"
                   Foreground="#555" Margin="0,0,0,10"/>
        <StatusBar DockPanel.Dock="Bottom">
            <TextBlock x:Name="StatusText" Text="等待操作…"/>
        </StatusBar>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>

                <GroupBox Header="文本输入" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBox Text="单行文本框" TextChanged="Text_Changed" Margin="0,0,0,6"/>
                        <TextBox Text="多行文本框&#10;第二行" AcceptsReturn="True" TextWrapping="Wrap"
                                 Height="60" VerticalScrollBarVisibility="Auto" Margin="0,0,0,6"/>
                        <PasswordBox Password="12345" PasswordChanged="Any_Changed" Width="160"
                                     HorizontalAlignment="Left"/>
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="选择" Margin="0,0,0,10">
                    <StackPanel>
                        <CheckBox Content="普通复选框" IsChecked="True" Checked="Any_Changed"
                                  Unchecked="Any_Changed" Margin="0,0,0,6"/>
                        <CheckBox Content="三态复选框（IsChecked 是 bool?）" IsThreeState="True"
                                  IsChecked="{x:Null}" Margin="0,0,0,6"/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <RadioButton Content="选项 A" GroupName="g1" IsChecked="True"
                                         Checked="Any_Changed" Margin="0,0,16,0"/>
                            <RadioButton Content="选项 B" GroupName="g1" Checked="Any_Changed"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <ComboBox x:Name="CityBox" Width="140" SelectionChanged="Combo_Changed">
                                <ComboBoxItem Content="北京" IsSelected="True"/>
                                <ComboBoxItem Content="上海"/>
                                <ComboBoxItem Content="深圳"/>
                            </ComboBox>
                        </StackPanel>
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="数值与进度" Margin="0,0,0,10">
                    <StackPanel>
                        <Slider Minimum="0" Maximum="100" Value="40" TickFrequency="10"
                                IsSnapToTickEnabled="True" ValueChanged="Slider_Changed" Margin="0,0,0,6"/>
                        <ProgressBar x:Name="DemoProgress" Minimum="0" Maximum="100" Height="18" Value="40"/>
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="列表" Margin="0,0,0,10">
                    <ListBox x:Name="FruitBox" Height="110" SelectionChanged="List_Changed">
                        <ListBoxItem Content="苹果"/>
                        <ListBoxItem Content="香蕉"/>
                        <ListBoxItem Content="樱桃"/>
                        <ListBoxItem Content="榴莲"/>
                    </ListBox>
                </GroupBox>

                <GroupBox Header="其他" Margin="0,0,0,10">
                    <StackPanel>
                        <Button Content="悬停我有工具提示" ToolTip="ToolTip 是免费的，给控件加一行说明就用它"
                                Width="220" HorizontalAlignment="Left" Click="Any_Changed" Margin="0,0,0,6"/>
                        <Expander Header="点我展开（Expander）" IsExpanded="False">
                            <TextBlock Text="折叠面板：放次要选项，默认收起。设置中心常见。"
                                       Margin="8" TextWrapping="Wrap"/>
                        </Expander>
                    </StackPanel>
                </GroupBox>

            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
