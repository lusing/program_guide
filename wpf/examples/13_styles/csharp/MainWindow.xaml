<Window x:Class="StyleDemo.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Style Demo" Height="280" Width="500">
    <Window.Resources>
        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#3B82F6"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="Margin" Value="0,0,12,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#2563EB"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- 动态资源换肤的「颜料」（教材 10.3.2 / 11.3.5）：DynamicResource 引用，改了就地刷新 -->
        <SolidColorBrush x:Key="accentBrush" Color="#8B5CF6"/>

        <Style x:Key="AccentTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#1D4ED8"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>
    </Window.Resources>

    <StackPanel Margin="20">
        <TextBlock Text="样式与资源示例" Style="{StaticResource AccentTextStyle}" Margin="0,0,0,12"/>
        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
            <Button Content="保存" Style="{StaticResource PrimaryButtonStyle}"/>
            <Button Content="取消" Width="96"/>
        </StackPanel>
        <TextBox Text="统一风格的文本框" Height="32" Width="260" HorizontalAlignment="Left" Margin="0,0,0,12"/>
        <Button x:Name="SkinButton" Content="动态资源皮肤（点我换肤）"
                Background="{DynamicResource accentBrush}" Foreground="White"
                Padding="14,8" HorizontalAlignment="Left" Click="SkinButton_Click"/>
    </StackPanel>
</Window>
