<Window x:Class="DrawingDemo.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="绘图与变换" Height="600" Width="600">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="16">

            <TextBlock Text="① Shape 全家福：Canvas 上用绝对坐标拼一张小场景" FontWeight="Bold"
                       Margin="0,0,0,8"/>
            <Border BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="8" ClipToBounds="True">
                <Canvas Width="540" Height="230" Background="#F8FAFC">

                    <!-- 山丘：Path + 二次贝塞尔曲线 -->
                    <Path Data="M 0,200 Q 135,130 270,200 T 540,200 L 540,230 L 0,230 Z"
                          Fill="#BBF7D0"/>

                    <!-- 太阳：Ellipse + RadialGradientBrush（径向渐变：中心亮、边缘橙） -->
                    <Ellipse Canvas.Left="400" Canvas.Top="26" Width="70" Height="70">
                        <Ellipse.Fill>
                            <RadialGradientBrush GradientOrigin="0.4,0.4">
                                <GradientStop Color="#FEF9C3" Offset="0"/>
                                <GradientStop Color="#FBBF24" Offset="1"/>
                            </RadialGradientBrush>
                        </Ellipse.Fill>
                    </Ellipse>

                    <!-- 房身：Rectangle + LinearGradientBrush（线性渐变：左浅右深） -->
                    <Rectangle Canvas.Left="120" Canvas.Top="100" Width="150" Height="95"
                               Stroke="#7C2D12" StrokeThickness="1.5">
                        <Rectangle.Fill>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="#FDE68A" Offset="0"/>
                                <GradientStop Color="#F59E0B" Offset="1"/>
                            </LinearGradientBrush>
                        </Rectangle.Fill>
                    </Rectangle>

                    <!-- 屋顶：Polygon（多边形，点序列首尾自动闭合） -->
                    <Polygon Points="108,100 282,100 195,44" Fill="#B91C1C"/>

                    <!-- 门与窗：小矩形 -->
                    <Rectangle Canvas.Left="180" Canvas.Top="142" Width="32" Height="53" Fill="#78350F"/>
                    <Rectangle Canvas.Left="138" Canvas.Top="118" Width="26" Height="26" Fill="#E0F2FE" Stroke="#0369A1"/>
                    <Rectangle Canvas.Left="228" Canvas.Top="118" Width="26" Height="26" Fill="#E0F2FE" Stroke="#0369A1"/>

                    <!-- 篱笆：Line 的重复摆放（Canvas 子元素用附加属性定位） -->
                    <Line X1="330" Y1="195" X2="330" Y2="165" Stroke="#92400E" StrokeThickness="3"/>
                    <Line X1="350" Y1="195" X2="350" Y2="165" Stroke="#92400E" StrokeThickness="3"/>
                    <Line X1="370" Y1="195" X2="370" Y2="165" Stroke="#92400E" StrokeThickness="3"/>
                    <Line X1="322" Y1="172" X2="378" Y2="172" Stroke="#92400E" StrokeThickness="2"/>
                </Canvas>
            </Border>
            <TextBlock Text="Canvas.Left / Canvas.Top 是附加属性——只在 Canvas 里生效，子元素坐标完全由你指定"
                       Foreground="#555" FontSize="11" Margin="0,6,0,0"/>

            <TextBlock Text="② 三种画刷" FontWeight="Bold" Margin="0,18,0,8"/>
            <StackPanel Orientation="Horizontal">
                <StackPanel Margin="0,0,12,0">
                    <Rectangle Width="150" Height="44" Fill="#3B82F6" RadiusX="6" RadiusY="6"/>
                    <TextBlock Text="SolidColorBrush 纯色" FontSize="11" Margin="0,4,0,0"/>
                </StackPanel>
                <StackPanel Margin="0,0,12,0">
                    <Rectangle Width="150" Height="44" RadiusX="6" RadiusY="6">
                        <Rectangle.Fill>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="#3B82F6" Offset="0"/>
                                <GradientStop Color="#10B981" Offset="1"/>
                            </LinearGradientBrush>
                        </Rectangle.Fill>
                    </Rectangle>
                    <TextBlock Text="LinearGradient 线性渐变" FontSize="11" Margin="0,4,0,0"/>
                </StackPanel>
                <StackPanel>
                    <Rectangle Width="150" Height="44" RadiusX="6" RadiusY="6">
                        <Rectangle.Fill>
                            <RadialGradientBrush>
                                <GradientStop Color="#FDE047" Offset="0"/>
                                <GradientStop Color="#EA580C" Offset="1"/>
                            </RadialGradientBrush>
                        </Rectangle.Fill>
                    </Rectangle>
                    <TextBlock Text="RadialGradient 径向渐变" FontSize="11" Margin="0,4,0,0"/>
                </StackPanel>
            </StackPanel>

            <TextBlock Text="③ 变换：RenderTransform 不改布局尺寸，只改渲染结果" FontWeight="Bold"
                       Margin="0,18,0,8"/>
            <StackPanel Orientation="Horizontal">
                <Polygon x:Name="Star" Points="60,20 69,47 98,48 75,65 84,92 60,76 37,92 45,65 22,48 51,47"
                         Fill="#F59E0B" Stroke="#B45309" StrokeThickness="1.5"
                         RenderTransformOrigin="0.5,0.5" Margin="20">
                    <Polygon.RenderTransform>
                        <TransformGroup>
                            <RotateTransform x:Name="StarRotate"/>
                            <ScaleTransform x:Name="StarScale"/>
                        </TransformGroup>
                    </Polygon.RenderTransform>
                </Polygon>
                <StackPanel VerticalAlignment="Center" Margin="20,0,0,0">
                    <Button Content="旋转 30°" Width="110" Margin="0,0,0,8" Click="Rotate_Click"/>
                    <Button Content="放大 1.2×" Width="110" Margin="0,0,0,8" Click="ScaleUp_Click"/>
                    <Button Content="重置" Width="110" Click="Reset_Click"/>
                </StackPanel>
            </StackPanel>


            <TextBlock Text="④ 3D 一瞥（教材 7.3）：Viewport3D + 网格 + 材质 + 灯光 + 相机" FontWeight="Bold"
                       Margin="0,18,0,8"/>
            <Border BorderBrush="#CBD5E1" BorderThickness="1" Height="220">
                <Viewport3D>
                    <Viewport3D.Camera>
                        <PerspectiveCamera Position="2.4,2.2,3" LookDirection="-2.4,-2.2,-3"
                                            UpDirection="0,1,0" FieldOfView="45"/>
                    </Viewport3D.Camera>
                    <ModelVisual3D>
                        <ModelVisual3D.Transform>
                            <RotateTransform3D>
                                <RotateTransform3D.Rotation>
                                    <AxisAngleRotation3D x:Name="Spin" Axis="0,1,0" Angle="0"/>
                                </RotateTransform3D.Rotation>
                            </RotateTransform3D>
                        </ModelVisual3D.Transform>
                        <ModelVisual3D.Content>
                            <Model3DGroup>
                                <AmbientLight Color="#444444"/>
                                <DirectionalLight Color="#FFFFFF" Direction="-1,-1,-3"/>
                                <GeometryModel3D>
                                    <!-- 四棱锥：顶点 + 底面四角，四个侧面三角形 -->
                                    <GeometryModel3D.Geometry>
                                        <MeshGeometry3D Positions="0,1,0 -1,0,1 1,0,1 1,0,-1 -1,0,-1"
                                                        TriangleIndices="0,1,2 0,2,3 0,3,4 0,4,1"/>
                                    </GeometryModel3D.Geometry>
                                    <GeometryModel3D.Material>
                                        <DiffuseMaterial Brush="SteelBlue"/>
                                    </GeometryModel3D.Material>
                                    <!-- 绕序画反也不至于黑屏：补一个背面材质 -->
                                    <GeometryModel3D.BackMaterial>
                                        <DiffuseMaterial Brush="LightSteelBlue"/>
                                    </GeometryModel3D.BackMaterial>
                                </GeometryModel3D>
                            </Model3DGroup>
                        </ModelVisual3D.Content>
                    </ModelVisual3D>
                </Viewport3D>
            </Border>
            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                <Button Content="旋转 45°" Width="110" Click="Spin_Click"/>
                <TextBlock Text="改变 AxisAngleRotation3D.Angle 即重渲染——与 2D 的 RenderTransform 同一思路"
                           Foreground="#555" FontSize="11" VerticalAlignment="Center" Margin="12,0,0,0"/>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Window>
