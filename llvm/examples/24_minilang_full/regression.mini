# MiniLang v1.0 回归主用例：一条程序覆盖全部语言特性
# 期望输出（run 与 obj-exe 两种模式都必须一致）：
#   55 / 5050 / 720 / 42 / 1024 / 1 / 0 / 1 / 0 / 0

def unary- (v) 0 - v

def unary! (x) if x < 1 then 1 else x * !(x - 1)

def binary| 5 (l r) if l < r then r else l

def fib(n) if n < 2 then n else fib(n - 1) + fib(n - 2)

def sum_to(n) var acc = 0 in (for i = 1, n, 1 in acc = acc + i) * 0 + acc

def power(b, e) var r = 1 in (while 0 < e do (r = r * b) * 0 + (e = e - 1)) * 0 + r

def safe_div(n, d) if (0 < d || d < 0) && n / d < 100 then 1 else 0

print(fib(10))

print(sum_to(100))

print(!(6))

print(-(-42))

print(power(2, 10))

print(safe_div(90, 10))

print(safe_div(90, 0))

print(1 < 2 && 3 < 4)

print(2 < 1 || 3 < 2)

print(2 < 1 && 1 / 0 < 9)
