# 第 18 章测试输入：while / 短路逻辑

# 用 while 迭代求幂（线性版）。
# 注：折半版需要整数的奇偶判断，而 MiniLang 万物皆 double——
# exp/2 得 0.5 永远除不尽，这是"用 double 写整数算法"的经典坑
def power(b, e)
  var r = 1 in
    (while 0 < e do
      (r = r * b) * 0 +
      (e = e - 1)) * 0 + r

# 短路保护除法：d 为 0 时不计算 n/d（&& 左假则右不求值）
def safe_div(n, d) if (0 < d || d < 0) && n / d < 100 then 1 else 0

def unary- (v) 0 - v

print(power(2, 10))

print(safe_div(90, 10))

print(safe_div(90, 0))

print(1 < 2 && 3 < 4)

print(1 < 2 || 3 < 2)

print(2 < 1 || 3 < 2)

print(2 < 1 && 1 / 0 < 9)
